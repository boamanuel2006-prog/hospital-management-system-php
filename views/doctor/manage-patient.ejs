<%- include('../partials/layout-header', { title: 'Manage Patients', role: 'doctor', active: 'patients' }) %>
<div class="hms-page-title">
  <div>
    <h1>Manage Patients</h1>
    <p class="text-muted mb-0">View, update, and review patients assigned to you.</p>
  </div>
  <a class="btn btn-primary" href="/hms/doctor/add-patient.php"><i class="bi bi-person-plus me-1"></i>Add Patient</a>
</div>

<div class="hms-card p-4">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
    <h2 class="h5 mb-0">Patient List</h2>
    <input type="search" class="form-control" style="max-width: 320px;" placeholder="Search patients..." data-table-search="#patientsTable">
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle" id="patientsTable" data-sortable>
      <thead>
      <tr>
        <th data-sort>#</th>
        <th data-sort>Patient</th>
        <th data-sort>Contact</th>
        <th data-sort>Gender</th>
        <th data-sort>Created</th>
        <th data-sort>Updated</th>
        <th class="text-end">Action</th>
      </tr>
      </thead>
      <tbody>
      <% patients.forEach(function(patient, index) { %>
        <tr>
          <td><%= index + 1 %></td>
          <td class="fw-semibold"><%= patient.PatientName %></td>
          <td><%= patient.PatientContno %></td>
          <td><%= patient.PatientGender %></td>
          <td><%= patient.CreationDate %></td>
          <td><%= patient.UpdationDate || 'Not updated' %></td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="/hms/doctor/edit-patient.php?editid=<%= patient.ID %>"><i class="bi bi-pencil-square"></i></a>
            <a class="btn btn-sm btn-outline-secondary" href="/hms/doctor/view-patient.php?viewid=<%= patient.ID %>"><i class="bi bi-eye"></i></a>
          </td>
        </tr>
      <% }); %>
      <% if (!patients.length) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">No patients found.</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/layout-footer') %>
