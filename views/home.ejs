<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('brand') %> · <%= lang === 'pt' ? 'Gestão Hospitalar' : 'Hospital Management System' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/assets/css/hms-modern.css" rel="stylesheet">
</head>
<body>

<header class="hms-pub-header">
  <div class="hms-pub-header-inner">
    <a href="/" class="hms-wordmark"><%= t('brand') %></a>
    <nav class="hms-pub-nav" aria-label="Primary">
      <a href="#specialties"><%= t('nav.specialties') %></a>
      <a href="#infrastructure"><%= t('nav.infrastructure') %></a>
      <a href="#portals"><%= t('nav.portals') %></a>
      <a href="#about"><%= lang === 'pt' ? 'Institucional' : 'About' %></a>
      <a href="#contact"><%= t('nav.contact') %></a>
    </nav>
    <a class="hms-btn-primary" href="/hms/auth.php"><%= t('nav.bookCta') %></a>
  </div>
</header>

<section class="py-5 bg-white border-bottom">
  <div class="container" style="max-width: 1240px;">
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-6 d-flex flex-column justify-content-center py-lg-3">
        <div class="hms-meta-line mb-3">
          <span><%= t('hero.kicker') %></span>
        </div>
        <h1 class="display-5 fw-bold mb-3" style="line-height: 1.12;"><%= t('hero.title') %></h1>
        <p class="text-muted mb-4" style="max-width: 58ch; font-size: 1.04rem;"><%= t('hero.subtitle') %></p>
        <div class="d-flex flex-wrap align-items-center gap-3">
          <a href="/hms/auth.php?role=patient" class="hms-btn-primary"><%= t('hero.primaryCta') %></a>
          <a href="/hms/auth.php?mode=register" class="hms-btn-secondary"><%= t('auth.tabRegister') %></a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="hms-media-frame h-100" style="min-height: 360px;">
          <img src="/src/assets/images/hospital_modern_atrium_1795169999756.jpg" alt="<%= t('brand') %>" referrerpolicy="no-referrer">
        </div>
      </div>
    </div>

    <div class="hms-surface-card mt-4 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div class="hms-meta-line">
        <span class="text-dark fw-semibold"><%= t('hero.utilityHours') %></span>
        <span aria-hidden="true">·</span>
        <span><%= t('hero.utilityBeds') %>: <strong class="tabular text-dark"><%= availableBeds %> / <%= totalBeds %></strong></span>
        <span aria-hidden="true">·</span>
        <span><%= t('hero.utilityDoctors') %>: <strong class="tabular text-dark"><%= totalDoctors %></strong></span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="small text-muted"><%= lang === 'pt' ? 'Idioma' : 'Language' %></span>
        <div class="hms-lang-switch" role="group" aria-label="Language">
          <a href="/lang/pt?next=/" class="<%= lang === 'pt' ? 'active' : '' %>">Português</a>
          <a href="/lang/en?next=/" class="<%= lang === 'en' ? 'active' : '' %>">English</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="portals" class="py-5">
  <div class="container" style="max-width: 1240px;">
    <div class="mb-4">
      <h2 class="h3 fw-bold mb-1"><%= t('home.portalsTitle') %></h2>
      <p class="text-muted mb-0"><%= t('home.portalsSub') %></p>
    </div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="hms-surface-card p-4 h-100 d-flex flex-column">
          <div class="hms-meta-line mb-2">
            <span>01</span>
            <span aria-hidden="true">·</span>
            <span><%= t('roles.patient') %></span>
          </div>
          <h3 class="h5 fw-bold mb-2"><%= t('home.patientTitle') %></h3>
          <p class="text-muted small flex-grow-1 mb-3"><%= t('home.patientDesc') %></p>
          <div class="small text-muted mb-3 border-top pt-2">
            <span><%= t('home.demoCreds') %>:</span>
            <code class="text-dark">johndoe12@test.com</code> / <code class="text-dark">Test@123</code>
          </div>
          <a href="/hms/auth.php?role=patient" class="hms-btn-primary w-100"><%= t('home.enterPortal') %></a>
        </div>
      </div>
      <div class="col-md-4">
        <div class="hms-surface-card p-4 h-100 d-flex flex-column">
          <div class="hms-meta-line mb-2">
            <span>02</span>
            <span aria-hidden="true">·</span>
            <span><%= t('roles.doctor') %></span>
          </div>
          <h3 class="h5 fw-bold mb-2"><%= t('home.doctorTitle') %></h3>
          <p class="text-muted small flex-grow-1 mb-3"><%= t('home.doctorDesc') %></p>
          <div class="small text-muted mb-3 border-top pt-2">
            <span><%= t('home.demoCreds') %>:</span>
            <code class="text-dark">anujk123@test.com</code> / <code class="text-dark">Test@123</code>
          </div>
          <a href="/hms/auth.php?role=doctor" class="hms-btn-primary w-100"><%= t('home.enterPortal') %></a>
        </div>
      </div>
      <div class="col-md-4">
        <div class="hms-surface-card p-4 h-100 d-flex flex-column">
          <div class="hms-meta-line mb-2">
            <span>03</span>
            <span aria-hidden="true">·</span>
            <span><%= t('roles.admin') %></span>
          </div>
          <h3 class="h5 fw-bold mb-2"><%= t('home.adminTitle') %></h3>
          <p class="text-muted small flex-grow-1 mb-3"><%= t('home.adminDesc') %></p>
          <div class="small text-muted mb-3 border-top pt-2">
            <span><%= t('home.demoCreds') %>:</span>
            <code class="text-dark">admin</code> / <code class="text-dark">Test@12345</code>
          </div>
          <a href="/hms/auth.php?role=admin" class="hms-btn-primary w-100"><%= t('home.enterPortal') %></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="infrastructure" class="py-5 bg-white border-top border-bottom">
  <div class="container" style="max-width: 1240px;">
    <div class="row g-4 align-items-stretch mb-5">
      <div class="col-lg-6">
        <div class="hms-media-frame h-100" style="min-height: 320px;">
          <img src="/src/assets/images/clinical_consultation_suite_1795169997651.jpg" alt="Clinical Consultation" referrerpolicy="no-referrer">
        </div>
      </div>
      <div class="col-lg-6 d-flex flex-column justify-content-center">
        <h2 class="h3 fw-bold mb-2"><%= t('home.infraTitle') %></h2>
        <p class="text-muted mb-4"><%= t('home.infraLead') %></p>
        <div class="border-top pt-3 mb-3">
          <h3 class="h6 fw-bold mb-1"><%= t('home.infraPoint1Title') %></h3>
          <p class="text-muted small mb-0"><%= t('home.infraPoint1Desc') %></p>
        </div>
        <div class="border-top pt-3 mb-3">
          <h3 class="h6 fw-bold mb-1"><%= t('home.infraPoint2Title') %></h3>
          <p class="text-muted small mb-0"><%= t('home.infraPoint2Desc') %></p>
        </div>
        <div class="border-top pt-3">
          <h3 class="h6 fw-bold mb-1"><%= t('home.infraPoint3Title') %></h3>
          <p class="text-muted small mb-0"><%= t('home.infraPoint3Desc') %></p>
        </div>
      </div>
    </div>

    <div id="specialties" class="pt-3">
      <div class="mb-4">
        <h2 class="h3 fw-bold mb-1"><%= t('home.specialtiesTitle') %></h2>
        <p class="text-muted mb-0"><%= t('home.specialtiesSub') %></p>
      </div>
      <div class="row g-3">
        <% specializations.slice(0, 8).forEach(function(spec, idx) { %>
          <div class="col-sm-6 col-lg-3">
            <div class="hms-surface-card p-3 h-100">
              <div class="hms-meta-line mb-1">
                <span class="tabular">0<%= idx + 1 %></span>
                <span aria-hidden="true">·</span>
                <span><%= lang === 'pt' ? 'Departamento' : 'Department' %></span>
              </div>
              <div class="fw-semibold text-dark"><%= spec.specilization %></div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<section id="about" class="py-5">
  <div class="container" style="max-width: 1240px;">
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-6 d-flex flex-column justify-content-center">
        <div class="hms-meta-line mb-2"><span><%= t('home.aboutTitle') %></span></div>
        <h2 class="h3 fw-bold mb-3"><%= aboutPage ? aboutPage.PageTitle : t('home.aboutTitle') %></h2>
        <div class="text-muted" style="max-width: 62ch;"><%- aboutPage ? aboutPage.PageDescription : '' %></div>
      </div>
      <div class="col-lg-6">
        <div class="hms-media-frame h-100" style="min-height: 300px;">
          <img src="/src/assets/images/hospital_nursing_ward_1795169999587.jpg" alt="Hospital Nursing Station" referrerpolicy="no-referrer">
        </div>
      </div>
    </div>
  </div>
</section>

<section id="contact" class="py-5 bg-white border-top">
  <div class="container" style="max-width: 1240px;">
    <div class="row g-4">
      <div class="col-lg-5">
        <h2 class="h3 fw-bold mb-3"><%= t('home.contactTitle') %></h2>
        <p class="text-muted mb-4"><%= contactPage ? contactPage.PageDescription : '' %></p>
        <dl class="row small mb-0">
          <dt class="col-sm-3 text-muted"><%= t('home.email') %></dt>
          <dd class="col-sm-9"><%= contactPage ? contactPage.Email : '' %></dd>
          <dt class="col-sm-3 text-muted"><%= t('home.phone') %></dt>
          <dd class="col-sm-9 tabular"><%= contactPage ? contactPage.MobileNumber : '' %></dd>
          <dt class="col-sm-3 text-muted"><%= t('home.hoursLabel') %></dt>
          <dd class="col-sm-9"><%= contactPage ? contactPage.OpenningTime : '' %></dd>
        </dl>
      </div>
      <div class="col-lg-7">
        <div class="hms-surface-card p-4">
          <% if (contactSubmitted) { %>
            <div class="alert alert-success"><%= t('home.contactSuccess') %></div>
          <% } %>
          <form method="post" action="/contact">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label"><%= t('home.fullName') %></label>
                <input type="text" name="fullname" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label"><%= t('home.email') %></label>
                <input type="email" name="emailid" class="form-control" required>
              </div>
              <div class="col-12">
                <label class="form-label"><%= t('home.phone') %></label>
                <input type="text" name="mobileno" class="form-control" required>
              </div>
              <div class="col-12">
                <label class="form-label"><%= t('home.message') %></label>
                <textarea name="description" rows="4" class="form-control" required></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="hms-btn-primary"><%= t('home.sendMessage') %></button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="py-4 border-top bg-light">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3 small text-muted" style="max-width: 1240px;">
    <span><%= t('home.footerText') %></span>
    <div class="d-flex gap-3">
      <a href="/hms/auth.php?role=patient" class="text-muted text-decoration-none"><%= t('roles.patient') %></a>
      <a href="/hms/auth.php?role=doctor" class="text-muted text-decoration-none"><%= t('roles.doctor') %></a>
      <a href="/hms/auth.php?role=admin" class="text-muted text-decoration-none"><%= t('roles.admin') %></a>
    </div>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
