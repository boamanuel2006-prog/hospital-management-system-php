<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hospital Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/assets/css/style.css" rel="stylesheet">
  <style>
    .hero-banner {
      position: relative;
      min-height: 440px;
      background: linear-gradient(rgba(15, 23, 42, 0.55), rgba(15, 118, 110, 0.65)), url('/assets/images/slider/slider_1.jpg') center/cover no-repeat;
      color: #fff;
      display: flex;
      align-items: center;
    }
    .portal-card img {
      height: 185px;
      object-fit: cover;
    }
    .gallery-img {
      height: 200px;
      width: 100%;
      object-fit: cover;
      border-radius: 0.5rem;
    }
  </style>
</head>
<body>
<header class="bg-white border-bottom sticky-top">
  <div class="container py-2 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4">
      <img src="/assets/images/logo.png" alt="HMS Logo" style="height:38px;">
      <span>HMS Hospital</span>
    </a>
    <nav class="d-flex flex-wrap align-items-center gap-3">
      <a class="text-decoration-none text-dark fw-medium" href="#services">Services</a>
      <a class="text-decoration-none text-dark fw-medium" href="#about">About Us</a>
      <a class="text-decoration-none text-dark fw-medium" href="#gallery">Gallery</a>
      <a class="text-decoration-none text-dark fw-medium" href="#contact">Contact Us</a>
      <a class="text-decoration-none text-dark fw-medium" href="#logins">Logins</a>
      <a class="btn btn-success btn-sm" href="/hms/user-login.php">Book an Appointment</a>
    </nav>
  </div>
</header>

<section class="hero-banner">
  <div class="container py-5">
    <div class="col-lg-7">
      <span class="badge bg-light text-dark mb-3">Hospital Management System</span>
      <h1 class="display-5 fw-bold mb-3">Integrated Care, Scheduling &amp; Clinical Records</h1>
      <p class="lead mb-4">Book appointments with specialists, manage doctor availability, issue digital prescriptions, and oversee hospital operations from one unified portal.</p>
      <div class="d-flex flex-wrap gap-2">
        <a href="/hms/user-login.php" class="btn btn-light btn-lg fw-semibold">Patient Portal</a>
        <a href="/hms/doctor/index.php" class="btn btn-outline-light btn-lg">Doctor Portal</a>
        <a href="/hms/admin/index.php" class="btn btn-outline-light btn-lg">Admin Portal</a>
      </div>
    </div>
  </div>
</section>

<section id="logins" class="py-5 bg-light">
  <div class="container">
    <div class="text-center mb-4">
      <h2 class="fw-bold">Logins</h2>
      <p class="text-muted">Access your role-specific Hospital Management System workspace.</p>
    </div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 portal-card">
          <img src="/assets/images/patient.jpg" class="card-img-top" alt="Patient Login">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold">Patient Login</h5>
            <p class="card-text text-muted small flex-grow-1">Book appointments, reschedule visits, view medical history, and download prescriptions.</p>
            <div class="small text-muted mb-3">Demo: <code>johndoe12@test.com</code> / <code>Test@123</code></div>
            <a href="/hms/user-login.php" class="btn btn-success w-100">Click Here</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 portal-card">
          <img src="/assets/images/doctor.jpg" class="card-img-top" alt="Doctor Login">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold">Doctors Login</h5>
            <p class="card-text text-muted small flex-grow-1">Review daily schedules, manage availability slots, record patient visits, and issue prescriptions.</p>
            <div class="small text-muted mb-3">Demo: <code>anujk123@test.com</code> / <code>Test@123</code></div>
            <a href="/hms/doctor/index.php" class="btn btn-success w-100">Click Here</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 portal-card">
          <img src="/assets/images/admin.jpg" class="card-img-top" alt="Admin Login">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold">Admin Login</h5>
            <p class="card-text text-muted small flex-grow-1">Manage doctors, patient accounts, appointment approvals, reports, notifications, and audit logs.</p>
            <div class="small text-muted mb-3">Demo: <code>admin</code> / <code>Test@12345</code></div>
            <a href="/hms/admin/index.php" class="btn btn-success w-100">Click Here</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="services" class="py-5">
  <div class="container">
    <div class="text-center mb-4">
      <h2 class="fw-bold">Our Key Features</h2>
      <p class="text-muted">Specialized departments and digital clinical workflows.</p>
    </div>
    <div class="row g-3">
      <% const icons = ['heart-pulse', 'capsule', 'hospital', 'clipboard2-pulse', 'bandaid', 'eye']; %>
      <% specializations.slice(0, 6).forEach(function(spec, idx) { %>
        <div class="col-md-4">
          <div class="p-4 border rounded-3 bg-white h-100 shadow-sm">
            <i class="bi bi-<%= icons[idx % icons.length] %> fs-2 text-success mb-2 d-inline-block"></i>
            <h5 class="fw-semibold"><%= spec.specilization %></h5>
            <p class="text-muted small mb-0">Dedicated specialist consultations, appointment tracking, and digital care records.</p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section id="about" class="py-5 bg-light">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-6">
        <img src="/assets/images/why.jpg" alt="About Hospital" class="img-fluid rounded-3 shadow-sm">
      </div>
      <div class="col-lg-6">
        <h2 class="fw-bold mb-3"><%= aboutPage ? aboutPage.PageTitle : 'About Our Hospital' %></h2>
        <div class="text-muted"><%- aboutPage ? aboutPage.PageDescription : '' %></div>
      </div>
    </div>
  </div>
</section>

<section id="gallery" class="py-5">
  <div class="container">
    <div class="text-center mb-4">
      <h2 class="fw-bold">Our Gallery</h2>
      <p class="text-muted">Modern clinical facilities and specialist care teams.</p>
    </div>
    <div class="row g-3">
      <% ['gallery_01.jpg','gallery_02.jpg','gallery_03.jpg','gallery_04.jpg','gallery_05.jpg','gallery_06.jpg'].forEach(function(img) { %>
        <div class="col-6 col-md-4">
          <img src="/assets/images/gallery/<%= img %>" alt="Hospital Gallery" class="gallery-img shadow-sm">
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section id="contact" class="py-5 bg-light">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-5">
        <h2 class="fw-bold mb-3">Contact Us</h2>
        <p class="text-muted mb-3"><%= contactPage ? contactPage.PageDescription : '' %></p>
        <ul class="list-unstyled text-muted small">
          <li class="mb-2"><i class="bi bi-envelope me-2 text-success"></i><%= contactPage ? contactPage.Email : 'info@gmail.com' %></li>
          <li class="mb-2"><i class="bi bi-telephone me-2 text-success"></i><%= contactPage ? contactPage.MobileNumber : '1122334455' %></li>
          <li><i class="bi bi-clock me-2 text-success"></i><%= contactPage ? contactPage.OpenningTime : '9 am To 8 Pm' %></li>
        </ul>
      </div>
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-4">
          <h4 class="fw-bold mb-3">Send a Message</h4>
          <% if (contactSubmitted) { %>
            <div class="alert alert-success">Your inquiry was submitted successfully. Our team will respond shortly.</div>
          <% } %>
          <form method="post" action="/contact">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullname" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Email Address</label>
                <input type="email" name="emailid" class="form-control" required>
              </div>
              <div class="col-12">
                <label class="form-label">Mobile Number</label>
                <input type="text" name="mobileno" class="form-control" required>
              </div>
              <div class="col-12">
                <label class="form-label">Message</label>
                <textarea name="description" rows="4" class="form-control" required></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-success">Send Message</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="bg-dark text-light py-3 text-center small">
  <div class="container">Hospital Management System</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
