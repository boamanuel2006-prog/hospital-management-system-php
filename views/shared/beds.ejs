<%- include('../partials/layout-header', { title: t('sidebar.beds'), role: role, active: 'beds' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.beds') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Ocupação hospitalar por enfermaria, internação de pacientes e liberação para higienização.' : 'Inpatient ward occupancy, guided patient admission, discharge, and bed maintenance.' %></div>
  </div>
</div>

<div class="hms-kpi-grid">
  <div class="hms-kpi-card">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Total de Leitos' : 'Total Beds' %></div>
    <div class="hms-kpi-value"><%= summary.total %></div>
  </div>
  <div class="hms-kpi-card">
    <div class="hms-kpi-label"><%= t('status.Available') %></div>
    <div class="hms-kpi-value" style="color: var(--hms-ok);"><%= summary.available %></div>
  </div>
  <div class="hms-kpi-card">
    <div class="hms-kpi-label"><%= t('status.Occupied') %></div>
    <div class="hms-kpi-value" style="color: var(--hms-danger);"><%= summary.occupied %></div>
  </div>
  <div class="hms-kpi-card">
    <div class="hms-kpi-label"><%= t('status.Maintenance') %></div>
    <div class="hms-kpi-value" style="color: var(--hms-muted);"><%= summary.maintenance %></div>
  </div>
</div>

<div class="hms-surface-card p-3 mb-3">
  <form class="d-flex flex-wrap gap-2 align-items-center" method="get" action="<%= actionUrl %>">
    <span class="small text-muted"><%= lang === 'pt' ? 'Enfermaria / Ala' : 'Hospital Ward' %>:</span>
    <select class="form-select form-select-sm" name="ward" style="max-width: 280px;" onchange="this.form.submit()">
      <option value=""><%= t('common.all') %></option>
      <% wards.forEach(function(w) { %>
        <option value="<%= w %>" <%= wardFilter === w ? 'selected' : '' %>><%= w %></option>
      <% }); %>
    </select>
    <% if (wardFilter) { %>
      <a class="btn btn-sm btn-outline-secondary" href="<%= actionUrl %>"><%= t('common.all') %></a>
    <% } %>
  </form>
</div>

<div class="row g-3">
  <% beds.forEach(function(bed) { %>
    <div class="col-md-6 col-xl-4">
      <div class="hms-surface-card p-3 h-100 d-flex flex-column justify-content-between">
        <div>
          <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <div>
              <div class="fw-bold tabular h5 mb-0"><%= bed.code %></div>
              <div class="hms-meta-line">
                <span><%= bed.ward %></span>
                <span aria-hidden="true">·</span>
                <span><%= bed.floor %></span>
              </div>
            </div>
            <%- statusBadge(bed.status) %>
          </div>

          <% if (bed.status === 'Occupied') { %>
            <div class="border-top pt-2 mt-2 small">
              <div class="fw-semibold text-dark"><%= bed.patientName %></div>
              <div class="text-muted"><%= t('common.doctor') %>: <%= bed.doctorName %></div>
              <div class="text-muted tabular"><%= lang === 'pt' ? 'Internado em' : 'Admitted' %>: <%= bed.admittedAt %></div>
              <% if (bed.notes) { %><div class="text-muted mt-1"><%= bed.notes %></div><% } %>
            </div>
          <% } else if (bed.notes) { %>
            <div class="border-top pt-2 mt-2 small text-muted"><%= bed.notes %></div>
          <% } %>
        </div>

        <div class="border-top pt-3 mt-3 d-flex flex-wrap gap-2">
          <% if (bed.status === 'Available') { %>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#admitModal<%= bed.id %>">
              <%= lang === 'pt' ? 'Internar Paciente' : 'Admit Patient' %>
            </button>
            <form method="post" action="<%= actionUrl %>" class="d-inline">
              <input type="hidden" name="action" value="maintenance">
              <input type="hidden" name="id" value="<%= bed.id %>">
              <button type="submit" class="btn btn-sm btn-outline-secondary"><%= t('status.Maintenance') %></button>
            </form>
          <% } else if (bed.status === 'Occupied') { %>
            <form method="post" action="<%= actionUrl %>" onsubmit="return confirm('<%= lang === 'pt' ? 'Confirmar alta e liberação do leito?' : 'Confirm discharge and release bed?' %>');">
              <input type="hidden" name="action" value="discharge">
              <input type="hidden" name="id" value="<%= bed.id %>">
              <button type="submit" class="btn btn-sm btn-outline-primary"><%= lang === 'pt' ? 'Registrar Alta' : 'Discharge Bed' %></button>
            </form>
          <% } else { %>
            <form method="post" action="<%= actionUrl %>">
              <input type="hidden" name="action" value="maintenance">
              <input type="hidden" name="id" value="<%= bed.id %>">
              <button type="submit" class="btn btn-sm btn-outline-success"><%= lang === 'pt' ? 'Liberar Leito' : 'Mark Available' %></button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <% if (bed.status === 'Available') { %>
      <div class="modal fade" id="admitModal<%= bed.id %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <form class="modal-content" method="post" action="<%= actionUrl %>">
            <div class="modal-header">
              <h5 class="modal-title"><%= lang === 'pt' ? 'Internação' : 'Bed Admission' %> · <span class="tabular"><%= bed.code %></span></h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="action" value="admit">
              <input type="hidden" name="id" value="<%= bed.id %>">
              <div class="mb-3">
                <label class="form-label"><%= t('common.patient') %></label>
                <input class="form-control" name="patientName" required>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('common.doctor') %></label>
                <select class="form-select" name="doctorId">
                  <% doctors.forEach(function(d) { %>
                    <option value="<%= d.id %>"><%= d.doctorName %> (<%= d.specilization %>)</option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-2">
                <label class="form-label"><%= lang === 'pt' ? 'Observações Clínicas' : 'Clinical Notes' %></label>
                <textarea class="form-control" name="notes" rows="2"></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-light" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
              <button type="submit" class="btn btn-primary"><%= lang === 'pt' ? 'Confirmar Internação' : 'Confirm Admission' %></button>
            </div>
          </form>
        </div>
      </div>
    <% } %>
  <% }); %>
</div>
<%- include('../partials/layout-footer') %>
