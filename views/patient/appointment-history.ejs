<%- include('../partials/layout-header', { title: t('sidebar.myAppointments'), role: 'patient', active: 'appointments' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.myAppointments') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Acompanhe o status, remarque ou cancele consultas e baixe prescrições.' : 'Track status, reschedule visits, cancel when needed, and download prescriptions.' %></div>
  </div>
  <a class="hms-btn-primary" href="/hms/book-appointment.php"><i class="bi bi-calendar-plus"></i><%= t('sidebar.bookAppointment') %></a>
</div>

<div class="hms-surface-card p-3">
  <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><%= lang === 'pt' ? 'Histórico de Consultas' : 'Appointment History' %></h2>
    <input class="form-control form-control-sm" style="max-width:260px" placeholder="<%= t('common.search') %>" data-table-search="#appointmentTable">
  </div>
  <div class="table-responsive">
    <table class="hms-table" id="appointmentTable" data-sortable>
      <thead>
      <tr>
        <th data-sort>#</th>
        <th data-sort><%= t('common.doctor') %></th>
        <th data-sort><%= t('common.date') %> / <%= t('common.time') %></th>
        <th data-sort><%= t('common.status') %></th>
        <th class="text-end"><%= t('common.actions') %></th>
      </tr>
      </thead>
      <tbody>
      <% appointments.forEach(function(appointment) {
        const isClosed = appointment.status === 'Cancelled' || appointment.status === 'Completed';
      %>
        <tr>
          <td class="tabular text-muted">#<%= appointment.id %></td>
          <td>
            <div class="fw-semibold"><%= appointment.doctorName %></div>
            <div class="hms-meta-line">
              <span><%= appointment.doctorSpecialization %></span>
              <span aria-hidden="true">·</span>
              <span class="tabular">R$ <%= appointment.consultancyFees %></span>
            </div>
          </td>
          <td class="tabular"><%= appointment.appointmentDate %> <%= appointment.appointmentTime %></td>
          <td><%- statusBadge(appointment.status) %></td>
          <td class="text-end">
            <div class="d-inline-flex flex-wrap gap-2 justify-content-end">
              <% if (appointment.prescriptionId) { %>
                <a class="btn btn-sm btn-outline-success" href="/hms/prescription-download.php?id=<%= appointment.prescriptionId %>"><i class="bi bi-file-medical me-1"></i><%= lang === 'pt' ? 'Receita' : 'Rx' %></a>
              <% } %>
              <% if (!isClosed) { %>
                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#reschedule<%= appointment.id %>"><%= lang === 'pt' ? 'Remarcar' : 'Reschedule' %></button>
                <form method="post" action="/hms/appointment-history.php" class="d-inline" onsubmit="return confirm('<%= lang === 'pt' ? 'Cancelar esta consulta?' : 'Cancel this appointment?' %>');">
                  <input type="hidden" name="action" value="cancel">
                  <input type="hidden" name="appointment_id" value="<%= appointment.id %>">
                  <button class="btn btn-sm btn-outline-secondary" type="submit"><%= t('common.cancel') %></button>
                </form>
              <% } %>
            </div>
          </td>
        </tr>
      <% }); %>
      <% if (!appointments.length) { %>
        <tr><td colspan="5" class="text-center text-muted py-4"><%= t('common.noRecords') %></td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<% appointments.forEach(function(appointment) {
  if (appointment.status === 'Cancelled' || appointment.status === 'Completed') return;
%>
  <div class="modal fade" id="reschedule<%= appointment.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" method="post" action="/hms/appointment-history.php">
        <div class="modal-header">
          <h5 class="modal-title"><%= lang === 'pt' ? 'Remarcar Consulta' : 'Reschedule Appointment' %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="action" value="reschedule">
          <input type="hidden" name="appointment_id" value="<%= appointment.id %>">
          <div class="mb-3">
            <label class="form-label"><%= lang === 'pt' ? 'Horários do Médico' : 'Doctor Availability' %></label>
            <div class="form-text"><%= appointment.availabilitySummary %></div>
          </div>
          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label"><%= lang === 'pt' ? 'Nova Data' : 'New Date' %></label>
              <input class="form-control" type="date" name="appointment_date" value="<%= appointment.appointmentDate %>" min="<%= today %>" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label"><%= lang === 'pt' ? 'Novo Horário' : 'New Time' %></label>
              <input class="form-control" type="time" name="appointment_time" value="<%= String(appointment.appointmentTime).slice(0, 5) %>" required>
            </div>
          </div>
          <div class="mt-3">
            <label class="form-label"><%= lang === 'pt' ? 'Motivo' : 'Reason' %></label>
            <textarea class="form-control" name="reason" rows="3" maxlength="255"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal"><%= t('common.close') %></button>
          <button type="submit" class="btn btn-primary"><%= t('common.submit') %></button>
        </div>
      </form>
    </div>
  </div>
<% }); %>
<%- include('../partials/layout-footer') %>
