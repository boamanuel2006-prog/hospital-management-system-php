<%- include('../partials/layout-header', { title: t('sidebar.bookAppointment'), role: 'patient', active: 'book' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.bookAppointment') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Escolha a especialidade, consulte os horários disponíveis e envie sua solicitação.' : 'Choose a specialist, review schedule availability, and submit an appointment request.' %></div>
  </div>
  <a class="hms-btn-secondary" href="/hms/appointment-history.php"><i class="bi bi-calendar-check"></i><%= t('sidebar.myAppointments') %></a>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="hms-surface-card p-3">
      <form method="post" action="/hms/book-appointment.php" id="bookingForm">
        <div class="mb-3">
          <label class="form-label"><%= t('common.specialty') %></label>
          <select class="form-select" name="Doctorspecialization" id="specialization" required>
            <option value=""><%= lang === 'pt' ? 'Selecione a especialidade' : 'Select specialization' %></option>
            <% specialties.forEach(function(s) { %>
              <option value="<%= s.specilization %>"><%= s.specilization %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= t('common.doctor') %></label>
          <select class="form-select" name="doctor" id="doctor" required>
            <option value=""><%= lang === 'pt' ? 'Selecione o médico' : 'Select doctor' %></option>
            <% doctors.forEach(function(doctor) { %>
              <option value="<%= doctor.id %>" data-specialization="<%= doctor.specilization %>" data-fee="<%= doctor.docFees %>" data-availability="<%= doctor.availabilitySummary %>">
                <%= doctor.doctorName %> (<%= doctor.specilization %>)
              </option>
            <% }); %>
          </select>
          <div class="form-text" id="availabilityText"><%= lang === 'pt' ? 'Selecione um médico para visualizar os horários.' : 'Select a physician to view availability.' %></div>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= lang === 'pt' ? 'Valor da Consulta (R$)' : 'Consultancy Fee' %></label>
          <input class="form-control tabular" id="fees" value="" readonly>
        </div>
        <div class="row g-3">
          <div class="col-sm-6">
            <label class="form-label"><%= t('common.date') %></label>
            <input class="form-control" type="date" name="appdate" min="<%= today %>" required>
          </div>
          <div class="col-sm-6">
            <label class="form-label"><%= t('common.time') %></label>
            <input class="form-control" type="time" name="apptime" required>
          </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
          <a class="hms-btn-secondary" href="/hms/dashboard.php"><%= t('common.cancel') %></a>
          <button class="hms-btn-primary" type="submit"><i class="bi bi-send"></i><%= lang === 'pt' ? 'Confirmar Solicitação' : 'Submit Request' %></button>
        </div>
      </form>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="hms-surface-card p-3 h-100">
      <h2 class="h5 mb-2"><%= lang === 'pt' ? 'Fluxo de Atendimento' : 'Appointment Workflow' %></h2>
      <div class="text-muted small mb-3"><%= lang === 'pt' ? 'A disponibilidade é validada no envio para evitar conflitos de horário.' : 'Availability is verified on submission to prevent double-booking.' %></div>
      <div class="hms-timeline">
        <div class="hms-timeline-item">
          <div class="fw-semibold"><%= t('status.Pending') %></div>
          <div class="small text-muted"><%= lang === 'pt' ? 'Solicitação enviada para conferência da recepção ou médico.' : 'Request awaiting clinical or reception confirmation.' %></div>
        </div>
        <div class="hms-timeline-item">
          <div class="fw-semibold"><%= t('status.Approved') %></div>
          <div class="small text-muted"><%= lang === 'pt' ? 'Horário reservado e confirmado no ambulatório.' : 'Visit confirmed on the clinic schedule.' %></div>
        </div>
        <div class="hms-timeline-item">
          <div class="fw-semibold"><%= t('status.Completed') %></div>
          <div class="small text-muted"><%= lang === 'pt' ? 'Consulta realizada com receita e pedidos de exame disponíveis.' : 'Visit finished with prescription and diagnostic records ready.' %></div>
        </div>
      </div>
    </div>
  </div>
</div>
<% const extraScript = `<script>
var specialization = document.getElementById("specialization");
var doctor = document.getElementById("doctor");
var fee = document.getElementById("fees");
var availability = document.getElementById("availabilityText");
var allOptions = Array.from(doctor.querySelectorAll("option")).slice(1);
var defaultAvail = ${JSON.stringify(lang === 'pt' ? 'Selecione um médico para visualizar os horários.' : 'Select a physician to view availability.')};

function filterDoctors() {
  var selected = specialization.value;
  doctor.value = "";
  fee.value = "";
  availability.textContent = defaultAvail;
  allOptions.forEach(function(option) {
    option.hidden = selected && option.dataset.specialization !== selected;
  });
}
function updateDoctorMeta() {
  var option = doctor.options[doctor.selectedIndex];
  fee.value = option && option.dataset.fee ? option.dataset.fee : "";
  availability.textContent = option && option.dataset.availability ? option.dataset.availability : defaultAvail;
}
specialization.addEventListener("change", filterDoctors);
doctor.addEventListener("change", updateDoctorMeta);
</script>`; %>
<%- include('../partials/layout-footer', { extraScript }) %>
