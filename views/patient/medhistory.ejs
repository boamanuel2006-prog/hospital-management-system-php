<%- include('../partials/layout-header', { title: 'Medical History', role: 'patient', active: 'medhistory' }) %>
<div class="hms-page-title">
  <div>
    <h1>Medical History &amp; Prescriptions</h1>
    <div class="text-muted">Review your clinical records and issued prescriptions.</div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="hms-card p-3 h-100">
      <h2 class="h5 mb-3">Prescriptions</h2>
      <% if (prescriptions.length) { %>
        <div class="timeline">
          <% prescriptions.forEach(function(p) { %>
            <div class="timeline-item">
              <div class="d-flex justify-content-between align-items-start">
                <div class="fw-semibold"><%= p.diagnosis %></div>
                <a class="btn btn-sm btn-outline-success" href="/hms/prescription-download.php?id=<%= p.id %>"><i class="bi bi-download me-1"></i>View</a>
              </div>
              <div class="small text-muted">Dr. <%= p.doctorName %> | <%= p.created_at %></div>
              <div class="small mt-1"><strong>Medicines:</strong> <%= p.medicines %></div>
              <div class="small"><strong>Treatment:</strong> <%= p.treatment %></div>
              <% if (p.followup_date) { %>
                <div class="small text-muted">Follow-up: <%= p.followup_date %></div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-muted">No prescriptions recorded yet.</div>
      <% } %>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="hms-card p-3 h-100">
      <h2 class="h5 mb-3">Clinical Vitals &amp; Notes</h2>
      <% if (history.length) { %>
        <div class="timeline">
          <% history.forEach(function(item) { %>
            <div class="timeline-item">
              <div class="fw-semibold"><%= item.CreationDate %></div>
              <div class="small text-muted">BP: <%= item.BloodPressure %> | Sugar: <%= item.BloodSugar %> | Weight: <%= item.Weight %> | Temp: <%= item.Temperature %></div>
              <div class="small mt-1"><%= item.MedicalPres %></div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-muted">No clinical vitals recorded for your email yet.</div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/layout-footer') %>
