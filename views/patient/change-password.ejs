<%- include('../partials/layout-header', { title: 'Change Password', role: role, active: 'password' }) %>
<div class="hms-page-title">
  <div>
    <h1>Change Password</h1>
    <div class="text-muted">Update your account password.</div>
  </div>
</div>
<div class="hms-card p-4" style="max-width:540px">
  <form method="post" action="<%= actionUrl %>">
    <div class="mb-3">
      <label class="form-label">Current Password</label>
      <input type="password" class="form-control" name="cpass" required>
    </div>
    <div class="mb-3">
      <label class="form-label">New Password</label>
      <input type="password" class="form-control" name="npass" minlength="6" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Confirm New Password</label>
      <input type="password" class="form-control" name="cfpass" minlength="6" required>
    </div>
    <button class="btn btn-primary" type="submit">Save Password</button>
  </form>
</div>
<%- include('../partials/layout-footer') %>
