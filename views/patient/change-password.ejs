<%- include('../partials/layout-header', { title: t('sidebar.password'), role: role, active: 'password' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.password') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Atualize a senha de acesso da sua conta.' : 'Update your account password.' %></div>
  </div>
</div>
<div class="hms-surface-card p-4" style="max-width:540px">
  <form method="post" action="<%= actionUrl %>">
    <div class="mb-3">
      <label class="form-label"><%= lang === 'pt' ? 'Senha Atual' : 'Current Password' %></label>
      <input type="password" class="form-control" name="cpass" required>
    </div>
    <div class="mb-3">
      <label class="form-label"><%= lang === 'pt' ? 'Nova Senha' : 'New Password' %></label>
      <input type="password" class="form-control" name="npass" minlength="6" required>
    </div>
    <div class="mb-3">
      <label class="form-label"><%= t('auth.confirmPassword') %></label>
      <input type="password" class="form-control" name="cfpass" minlength="6" required>
    </div>
    <button class="hms-btn-primary" type="submit"><%= t('common.save') %></button>
  </form>
</div>
<%- include('../partials/layout-footer') %>
