<%- include('../partials/layout-header', { title: t('sidebar.dashboard'), role: 'patient', active: 'dashboard' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= lang === 'pt' ? 'Painel do Paciente' : 'Patient Dashboard' %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Acompanhe consultas, resultados de exames, prescrições e guias financeiras.' : 'Track appointments, lab results, prescriptions, and billing receipts.' %></div>
  </div>
  <a class="hms-btn-primary" href="/hms/book-appointment.php"><i class="bi bi-calendar-plus"></i><%= t('sidebar.bookAppointment') %></a>
</div>

<div class="hms-kpi-grid">
  <a class="hms-kpi-card" href="/hms/appointment-history.php">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Consultas Agendadas' : 'Total Appointments' %></div>
    <div class="hms-kpi-value"><%= stats.appointments %></div>
    <div class="hms-kpi-foot tabular"><%= stats.pending %> <%= t('status.Pending') %> · <%= stats.completed %> <%= t('status.Completed') %></div>
  </a>
  <a class="hms-kpi-card" href="/hms/manage-medhistory.php">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Receitas e Prontuário' : 'Prescriptions & Records' %></div>
    <div class="hms-kpi-value"><%= stats.prescriptions %></div>
    <div class="hms-kpi-foot tabular"><%= stats.history %> <%= lang === 'pt' ? 'registros clínicos' : 'clinical entries' %></div>
  </a>
  <a class="hms-kpi-card" href="/hms/lab-results.php">
    <div class="hms-kpi-label"><%= t('sidebar.myExams') %></div>
    <div class="hms-kpi-value"><%= stats.labs %></div>
    <div class="hms-kpi-foot"><%= lang === 'pt' ? 'Laboratório e imagem' : 'Diagnostic exams' %></div>
  </a>
  <a class="hms-kpi-card" href="/hms/invoices.php">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Guias em Aberto' : 'Unpaid Invoices' %></div>
    <div class="hms-kpi-value"><%= stats.unpaidInvoices %></div>
    <div class="hms-kpi-foot"><%= lang === 'pt' ? 'Faturamento hospitalar' : 'Hospital billing' %></div>
  </a>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="hms-surface-card p-3 h-100 d-flex flex-column justify-content-between">
      <div>
        <h2 class="h5 mb-3"><%= lang === 'pt' ? 'Próxima Consulta' : 'Next Appointment' %></h2>
        <% if (nextAppointment) { %>
          <div class="fw-semibold fs-6"><%= nextAppointment.doctorName %></div>
          <div class="hms-meta-line mb-2">
            <span><%= nextAppointment.doctorSpecialization %></span>
            <span aria-hidden="true">·</span>
            <span class="tabular"><%= nextAppointment.appointmentDate %> <%= nextAppointment.appointmentTime %></span>
          </div>
          <div><%- statusBadge(nextAppointment.status) %></div>
        <% } else { %>
          <div class="text-muted small"><%= lang === 'pt' ? 'Nenhuma consulta futura agendada no momento.' : 'No upcoming appointment scheduled.' %></div>
        <% } %>
      </div>
      <div class="mt-4 d-flex flex-wrap gap-2">
        <a class="hms-btn-secondary flex-fill" href="/hms/appointment-history.php"><%= t('sidebar.myAppointments') %></a>
        <a class="hms-btn-secondary flex-fill" href="/hms/lab-results.php"><%= t('sidebar.myExams') %></a>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="hms-surface-card p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0"><%= lang === 'pt' ? 'Consultas Recentes' : 'Recent Appointments' %></h2>
        <span class="hms-meta-line"><strong class="tabular text-dark"><%= stats.prescriptions %></strong><span><%= t('sidebar.prescriptions') %></span></span>
      </div>
      <div class="table-responsive">
        <table class="hms-table" data-sortable>
          <thead>
          <tr>
            <th data-sort><%= t('common.doctor') %></th>
            <th data-sort><%= t('common.date') %></th>
            <th data-sort><%= t('common.status') %></th>
            <th class="text-end"><%= t('common.fee') %></th>
          </tr>
          </thead>
          <tbody>
          <% recentAppointments.forEach(function(appointment) { %>
            <tr>
              <td>
                <div class="fw-semibold"><%= appointment.doctorName %></div>
                <div class="small text-muted"><%= appointment.doctorSpecialization %></div>
              </td>
              <td class="tabular"><%= appointment.appointmentDate %> <%= appointment.appointmentTime %></td>
              <td><%- statusBadge(appointment.status) %></td>
              <td class="text-end tabular">R$ <%= appointment.consultancyFees %></td>
            </tr>
          <% }); %>
          <% if (!recentAppointments.length) { %>
            <tr><td colspan="4" class="text-center text-muted py-4"><%= t('common.noRecords') %></td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/layout-footer') %>
