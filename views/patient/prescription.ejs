<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <title><%= lang === 'pt' ? 'Receita Médica' : 'Medical Prescription' %> #<%= prescription.id %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/css/hms-modern.css" rel="stylesheet">
</head>
<body class="p-4">
  <div class="container" style="max-width:740px">
    <div class="hms-surface-card p-4">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
        <div>
          <div class="hms-meta-line mb-1"><span><%= t('brand') %></span></div>
          <h1 class="h4 fw-bold mb-0"><%= lang === 'pt' ? 'Receita Médica' : 'Medical Prescription' %></h1>
          <div class="text-muted small tabular">#<%= prescription.id %> · <%= lang === 'pt' ? 'Consulta' : 'Appointment' %> #<%= prescription.appointment_id %></div>
        </div>
        <button class="hms-btn-primary d-print-none" onclick="window.print()"><%= t('common.print') %></button>
      </div>
      <dl class="row mb-0">
        <dt class="col-sm-4 text-muted"><%= t('common.patient') %></dt>
        <dd class="col-sm-8 fw-semibold"><%= patient ? patient.fullName : '' %></dd>
        <dt class="col-sm-4 text-muted"><%= t('common.doctor') %></dt>
        <dd class="col-sm-8"><%= doctor ? doctor.doctorName : '' %> (<%= doctor ? doctor.specilization : '' %>)</dd>
        <dt class="col-sm-4 text-muted"><%= lang === 'pt' ? 'Diagnóstico' : 'Diagnosis' %></dt>
        <dd class="col-sm-8"><%= prescription.diagnosis %></dd>
        <dt class="col-sm-4 text-muted"><%= lang === 'pt' ? 'Conduta / Tratamento' : 'Treatment' %></dt>
        <dd class="col-sm-8"><%= prescription.treatment %></dd>
        <dt class="col-sm-4 text-muted"><%= lang === 'pt' ? 'Medicamentos' : 'Medicines' %></dt>
        <dd class="col-sm-8"><%= prescription.medicines %></dd>
        <dt class="col-sm-4 text-muted"><%= lang === 'pt' ? 'Observações' : 'Notes' %></dt>
        <dd class="col-sm-8"><%= prescription.notes || '-' %></dd>
        <dt class="col-sm-4 text-muted"><%= lang === 'pt' ? 'Retorno' : 'Follow-up Date' %></dt>
        <dd class="col-sm-8 tabular"><%= prescription.followup_date || '-' %></dd>
        <dt class="col-sm-4 text-muted"><%= lang === 'pt' ? 'Emissão' : 'Issued' %></dt>
        <dd class="col-sm-8 tabular"><%= prescription.created_at %></dd>
      </dl>
      <div class="mt-4 d-print-none">
        <a href="/hms/appointment-history.php" class="hms-btn-secondary btn-sm"><%= t('sidebar.myAppointments') %></a>
      </div>
    </div>
  </div>
</body>
</html>
