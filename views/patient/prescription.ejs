<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Prescription #<%= prescription.id %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">
  <div class="container" style="max-width:720px">
    <div class="card shadow-sm p-4">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
        <div>
          <h1 class="h4 mb-0">Medical Prescription</h1>
          <div class="text-muted small">Prescription #<%= prescription.id %> | Appointment #<%= prescription.appointment_id %></div>
        </div>
        <button class="btn btn-sm btn-primary d-print-none" onclick="window.print()">Print / Save PDF</button>
      </div>
      <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Patient</dt>
        <dd class="col-sm-8"><%= patient ? patient.fullName : '' %></dd>
        <dt class="col-sm-4 text-muted">Doctor</dt>
        <dd class="col-sm-8"><%= doctor ? doctor.doctorName : '' %> (<%= doctor ? doctor.specilization : '' %>)</dd>
        <dt class="col-sm-4 text-muted">Diagnosis</dt>
        <dd class="col-sm-8"><%= prescription.diagnosis %></dd>
        <dt class="col-sm-4 text-muted">Treatment</dt>
        <dd class="col-sm-8"><%= prescription.treatment %></dd>
        <dt class="col-sm-4 text-muted">Medicines</dt>
        <dd class="col-sm-8"><%= prescription.medicines %></dd>
        <dt class="col-sm-4 text-muted">Notes</dt>
        <dd class="col-sm-8"><%= prescription.notes || 'None' %></dd>
        <dt class="col-sm-4 text-muted">Follow-up Date</dt>
        <dd class="col-sm-8"><%= prescription.followup_date || 'N/A' %></dd>
        <dt class="col-sm-4 text-muted">Issued</dt>
        <dd class="col-sm-8"><%= prescription.created_at %></dd>
      </dl>
      <div class="mt-4 d-print-none">
        <a href="/hms/appointment-history.php" class="btn btn-outline-secondary btn-sm">Back to Appointments</a>
      </div>
    </div>
  </div>
</body>
</html>
