<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= t('brand') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/assets/css/hms-modern.css" rel="stylesheet">
  <style>
    body.hms-auth-bg {
      min-height: 100vh;
      background: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .hms-auth-shell {
      width: 100%;
      max-width: 540px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 2rem;
    }
    .hms-stepper {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .hms-step-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding-bottom: 0.55rem;
      border-bottom: 2px solid #e2e8f0;
      color: #64748b;
      font-size: 0.82rem;
      font-weight: 500;
    }
    .hms-step-item.active {
      border-bottom-color: var(--hms-accent);
      color: var(--hms-ink);
      font-weight: 600;
    }
    .hms-step-item.done {
      border-bottom-color: #0f766e;
      color: #0f766e;
    }
    .hms-step-num {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      font-weight: 600;
      background: #f1f5f9;
      color: #475569;
      flex-shrink: 0;
    }
    .hms-step-item.active .hms-step-num,
    .hms-step-item.done .hms-step-num {
      background: var(--hms-accent);
      color: #ffffff;
    }
    .hms-role-option {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      width: 100%;
      text-align: left;
      padding: 0.8rem 0.95rem;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      cursor: pointer;
      transition: border-color 140ms, background-color 140ms;
    }
    .hms-role-option:hover {
      border-color: #94a3b8;
    }
    .hms-role-option.selected {
      border-color: var(--hms-accent);
      background: #f0fdfa;
    }
    .hms-role-icon {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: #f1f5f9;
      color: #0f172a;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .hms-role-option.selected .hms-role-icon {
      background: var(--hms-accent);
      color: #ffffff;
    }
  </style>
</head>
<body class="hms-auth-bg">
  <div class="hms-auth-shell">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <a href="/" class="hms-wordmark text-decoration-none"><%= t('brand') %></a>
      <div class="hms-lang-switch" role="group" aria-label="Language">
        <a href="/lang/pt?next=<%= encodeURIComponent(currentUrl) %>" class="<%= lang === 'pt' ? 'active' : '' %>">PT</a>
        <a href="/lang/en?next=<%= encodeURIComponent(currentUrl) %>" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
      </div>
    </div>
    <div class="mb-3">
      <h1 class="h4 fw-bold mb-1"><%= heading %></h1>
      <p class="text-muted small mb-0"><%= subtitle %></p>
    </div>
    <% if (flashes && flashes.length) { %>
      <% flashes.forEach(function(f) { %>
        <div class="alert alert-<%= f.type %> py-2 small" role="alert"><%= f.message %></div>
      <% }); %>
    <% } %>
