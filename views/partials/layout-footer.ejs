    </main>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.querySelectorAll('[data-table-search]').forEach(function(input) {
    var selector = input.getAttribute('data-table-search');
    var table = document.querySelector(selector);
    if (!table) return;
    input.addEventListener('input', function() {
      var q = input.value.trim().toLowerCase();
      table.querySelectorAll('tbody tr').forEach(function(row) {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
      });
    });
  });

  document.querySelectorAll('table[data-sortable] th[data-sort]').forEach(function(th, index) {
    th.addEventListener('click', function() {
      var table = th.closest('table');
      var tbody = table.querySelector('tbody');
      var rows = Array.from(tbody.querySelectorAll('tr'));
      var asc = th.dataset.dir !== 'asc';
      th.dataset.dir = asc ? 'asc' : 'desc';
      rows.sort(function(a, b) {
        var av = (a.children[index]?.textContent || '').trim();
        var bv = (b.children[index]?.textContent || '').trim();
        var an = parseFloat(av);
        var bn = parseFloat(bv);
        if (!isNaN(an) && !isNaN(bn) && String(an) === av && String(bn) === bv) {
          return asc ? an - bn : bn - an;
        }
        return asc ? av.localeCompare(bv) : bv.localeCompare(av);
      });
      rows.forEach(function(r) { tbody.appendChild(r); });
    });
  });
</script>
<%- typeof extraScript !== 'undefined' && extraScript ? extraScript : '' %>
</body>
</html>
