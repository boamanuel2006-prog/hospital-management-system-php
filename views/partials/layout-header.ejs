<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Hospital Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --hms-primary: #0f766e;
      --hms-primary-dark: #115e59;
      --hms-bg: #f1f5f9;
      --hms-surface: #ffffff;
      --hms-border: #e2e8f0;
      --hms-text: #0f172a;
      --hms-muted: #64748b;
      --hms-sidebar-w: 256px;
    }
    body {
      background: var(--hms-bg);
      color: var(--hms-text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .hms-shell {
      display: flex;
      min-height: 100vh;
    }
    .hms-sidebar {
      width: var(--hms-sidebar-w);
      background: #0f172a;
      color: #e2e8f0;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
    .hms-brand {
      padding: 1.25rem 1.25rem 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 1.05rem;
    }
    .hms-nav {
      padding: 0.85rem 0.75rem;
      flex: 1;
    }
    .hms-nav-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #94a3b8;
      padding: 0.6rem 0.75rem 0.3rem;
      font-weight: 600;
    }
    .hms-nav a {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.6rem 0.85rem;
      border-radius: 0.55rem;
      color: #cbd5e1;
      text-decoration: none;
      font-size: 0.92rem;
      margin-bottom: 0.2rem;
      transition: background 0.15s, color 0.15s;
    }
    .hms-nav a:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
    }
    .hms-nav a.active {
      background: var(--hms-primary);
      color: #fff;
      font-weight: 600;
    }
    .hms-main {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    .hms-topbar {
      background: var(--hms-surface);
      border-bottom: 1px solid var(--hms-border);
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .hms-content {
      padding: 1.5rem;
      flex: 1;
    }
    .hms-page-title {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .hms-page-title h1 {
      font-size: 1.55rem;
      font-weight: 700;
      margin: 0;
    }
    .hms-card {
      background: var(--hms-surface);
      border: 1px solid var(--hms-border);
      border-radius: 0.85rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .hms-stat {
      padding: 1.15rem 1.25rem;
      text-decoration: none;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    a.hms-stat:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
    }
    .hms-stat .icon {
      display: inline-flex;
      width: 2.5rem;
      height: 2.5rem;
      align-items: center;
      justify-content: center;
      border-radius: 0.65rem;
      background: #ccfbf1;
      color: var(--hms-primary);
      font-size: 1.15rem;
      margin-bottom: 0.75rem;
    }
    .hms-stat .value {
      font-size: 1.65rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .hms-stat .label {
      color: var(--hms-muted);
      font-size: 0.88rem;
      margin-top: 0.2rem;
    }
    .timeline {
      border-left: 2px solid var(--hms-border);
      padding-left: 1rem;
      margin-left: 0.4rem;
    }
    .timeline-item {
      position: relative;
      padding-bottom: 1rem;
    }
    .timeline-item:last-child {
      padding-bottom: 0;
    }
    .timeline-item::before {
      content: "";
      position: absolute;
      left: -1.35rem;
      top: 0.32rem;
      width: 0.6rem;
      height: 0.6rem;
      border-radius: 50%;
      background: var(--hms-primary);
    }
    .btn-primary {
      background-color: var(--hms-primary);
      border-color: var(--hms-primary);
    }
    .btn-primary:hover, .btn-primary:focus {
      background-color: var(--hms-primary-dark);
      border-color: var(--hms-primary-dark);
    }
    .btn-outline-primary {
      color: var(--hms-primary);
      border-color: var(--hms-primary);
    }
    .btn-outline-primary:hover {
      background-color: var(--hms-primary);
      border-color: var(--hms-primary);
    }
    th[data-sort] {
      cursor: pointer;
      user-select: none;
    }
    @media (max-width: 991.98px) {
      .hms-sidebar {
        display: none;
      }
      .hms-sidebar.open {
        display: flex;
        position: fixed;
        z-index: 1050;
        left: 0;
        top: 0;
      }
    }
  </style>
</head>
<body>
<div class="hms-shell">
  <aside class="hms-sidebar" id="hmsSidebar">
    <a class="hms-brand" href="/">
      <i class="bi bi-hospital fs-4 text-info"></i>
      <span>HMS Portal</span>
    </a>
    <nav class="hms-nav">
      <% if (role === 'patient') { %>
        <div class="hms-nav-label">Patient</div>
        <a href="/hms/dashboard.php" class="<%= active === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i>Dashboard</a>
        <a href="/hms/book-appointment.php" class="<%= active === 'book' ? 'active' : '' %>"><i class="bi bi-calendar-plus"></i>Book Appointment</a>
        <a href="/hms/appointment-history.php" class="<%= active === 'appointments' ? 'active' : '' %>"><i class="bi bi-calendar-check"></i>My Appointments</a>
        <a href="/hms/manage-medhistory.php" class="<%= active === 'medhistory' ? 'active' : '' %>"><i class="bi bi-journal-medical"></i>Medical History</a>
        <div class="hms-nav-label">Account</div>
        <a href="/hms/edit-profile.php" class="<%= active === 'profile' ? 'active' : '' %>"><i class="bi bi-person"></i>My Profile</a>
        <a href="/hms/change-password.php" class="<%= active === 'password' ? 'active' : '' %>"><i class="bi bi-key"></i>Change Password</a>
        <a href="/hms/logout.php"><i class="bi bi-box-arrow-right"></i>Log Out</a>
      <% } else if (role === 'doctor') { %>
        <div class="hms-nav-label">Doctor</div>
        <a href="/hms/doctor/dashboard.php" class="<%= active === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i>Dashboard</a>
        <a href="/hms/doctor/appointment-history.php" class="<%= active === 'appointments' ? 'active' : '' %>"><i class="bi bi-calendar-check"></i>Appointments</a>
        <a href="/hms/doctor/availability.php" class="<%= active === 'availability' ? 'active' : '' %>"><i class="bi bi-clock-history"></i>Availability</a>
        <a href="/hms/doctor/prescriptions.php" class="<%= active === 'prescriptions' ? 'active' : '' %>"><i class="bi bi-file-medical"></i>Prescriptions</a>
        <a href="/hms/doctor/manage-patient.php" class="<%= active === 'patients' ? 'active' : '' %>"><i class="bi bi-people"></i>Patients</a>
        <div class="hms-nav-label">Account</div>
        <a href="/hms/doctor/edit-profile.php" class="<%= active === 'profile' ? 'active' : '' %>"><i class="bi bi-person"></i>My Profile</a>
        <a href="/hms/doctor/change-password.php" class="<%= active === 'password' ? 'active' : '' %>"><i class="bi bi-key"></i>Change Password</a>
        <a href="/hms/doctor/logout.php"><i class="bi bi-box-arrow-right"></i>Log Out</a>
      <% } else if (role === 'admin') { %>
        <div class="hms-nav-label">Operations</div>
        <a href="/hms/admin/dashboard.php" class="<%= active === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i>Dashboard</a>
        <a href="/hms/admin/appointment-history.php" class="<%= active === 'appointments' ? 'active' : '' %>"><i class="bi bi-calendar-check"></i>Appointments</a>
        <a href="/hms/admin/doctor-availability.php" class="<%= active === 'availability' ? 'active' : '' %>"><i class="bi bi-clock-history"></i>Doctor Availability</a>
        <a href="/hms/admin/manage-doctors.php" class="<%= active === 'doctors' ? 'active' : '' %>"><i class="bi bi-person-badge"></i>Doctors</a>
        <a href="/hms/admin/doctor-specilization.php" class="<%= active === 'specializations' ? 'active' : '' %>"><i class="bi bi-diagram-3"></i>Specializations</a>
        <a href="/hms/admin/manage-users.php" class="<%= active === 'users' ? 'active' : '' %>"><i class="bi bi-people"></i>Patient Accounts</a>
        <a href="/hms/admin/manage-patient.php" class="<%= active === 'patients' ? 'active' : '' %>"><i class="bi bi-person-vcard"></i>Clinical Records</a>
        <div class="hms-nav-label">Monitoring &amp; CMS</div>
        <a href="/hms/admin/notifications.php" class="<%= active === 'notifications' ? 'active' : '' %>"><i class="bi bi-bell"></i>Notifications</a>
        <a href="/hms/admin/unread-queries.php" class="<%= active === 'queries' ? 'active' : '' %>"><i class="bi bi-chat-left-text"></i>Contact Queries</a>
        <a href="/hms/admin/between-dates-reports.php" class="<%= active === 'reports' ? 'active' : '' %>"><i class="bi bi-file-earmark-bar-graph"></i>Reports</a>
        <a href="/hms/admin/audit-logs.php" class="<%= active === 'audit' ? 'active' : '' %>"><i class="bi bi-shield-check"></i>Audit Logs</a>
        <a href="/hms/admin/about-us.php" class="<%= active === 'aboutus' ? 'active' : '' %>"><i class="bi bi-info-circle"></i>About Us CMS</a>
        <a href="/hms/admin/contact.php" class="<%= active === 'contactus' ? 'active' : '' %>"><i class="bi bi-telephone"></i>Contact CMS</a>
        <a href="/hms/admin/change-password.php" class="<%= active === 'password' ? 'active' : '' %>"><i class="bi bi-key"></i>Change Password</a>
        <a href="/hms/admin/logout.php"><i class="bi bi-box-arrow-right"></i>Log Out</a>
      <% } %>
    </nav>
  </aside>
  <div class="hms-main">
    <header class="hms-topbar">
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('hmsSidebar').classList.toggle('open')">
          <i class="bi bi-list"></i>
        </button>
        <span class="fw-semibold text-muted small text-uppercase"><%= role %> Portal</span>
      </div>
      <div class="d-flex align-items-center gap-3">
        <span class="small text-muted"><i class="bi bi-person-circle me-1"></i><%= currentUserName || role %></span>
        <a class="btn btn-sm btn-outline-secondary" href="/">Public Site</a>
      </div>
    </header>
    <main class="hms-content">
      <% if (flashes && flashes.length) { %>
        <% flashes.forEach(function(f) { %>
          <div class="alert alert-<%= f.type %> alert-dismissible fade show" role="alert">
            <%= f.message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% }); %>
      <% } %>
