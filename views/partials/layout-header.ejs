<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= t('brand') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/assets/css/hms-modern.css" rel="stylesheet">
</head>
<body>
<div class="hms-shell">
  <aside class="hms-sidebar" id="hmsSidebar">
    <a class="hms-sidebar-brand" href="/">
      <i class="bi bi-hospital" style="color: #5eead4;"></i>
      <span><%= t('brandShort') %></span>
    </a>
    <nav class="hms-sidebar-nav">
      <% if (role === 'patient') { %>
        <div class="hms-nav-section"><%= t('sidebar.care') %></div>
        <a href="/hms/dashboard.php" class="<%= active === 'dashboard' ? 'active' : '' %>"><i class="bi bi-grid"></i><span><%= t('sidebar.dashboard') %></span></a>
        <a href="/hms/book-appointment.php" class="<%= active === 'book' ? 'active' : '' %>"><i class="bi bi-calendar-plus"></i><span><%= t('sidebar.bookAppointment') %></span></a>
        <a href="/hms/appointment-history.php" class="<%= active === 'appointments' ? 'active' : '' %>"><i class="bi bi-calendar-check"></i><span><%= t('sidebar.myAppointments') %></span></a>
        <a href="/hms/manage-medhistory.php" class="<%= active === 'medhistory' ? 'active' : '' %>"><i class="bi bi-journal-medical"></i><span><%= t('sidebar.medHistory') %></span></a>
        <a href="/hms/lab-results.php" class="<%= active === 'labs' ? 'active' : '' %>"><i class="bi bi-clipboard2-pulse"></i><span><%= t('sidebar.myExams') %></span></a>
        <a href="/hms/invoices.php" class="<%= active === 'invoices' ? 'active' : '' %>"><i class="bi bi-receipt"></i><span><%= t('sidebar.myInvoices') %></span></a>
        <div class="hms-nav-section"><%= t('sidebar.account') %></div>
        <a href="/hms/edit-profile.php" class="<%= active === 'profile' ? 'active' : '' %>"><i class="bi bi-person"></i><span><%= t('sidebar.profile') %></span></a>
        <a href="/hms/change-password.php" class="<%= active === 'password' ? 'active' : '' %>"><i class="bi bi-key"></i><span><%= t('sidebar.password') %></span></a>
        <a href="/hms/logout.php"><i class="bi bi-box-arrow-right"></i><span><%= t('sidebar.logout') %></span></a>
      <% } else if (role === 'doctor') { %>
        <div class="hms-nav-section"><%= t('sidebar.clinicalOps') %></div>
        <a href="/hms/doctor/dashboard.php" class="<%= active === 'dashboard' ? 'active' : '' %>"><i class="bi bi-grid"></i><span><%= t('sidebar.dashboard') %></span></a>
        <a href="/hms/doctor/appointment-history.php" class="<%= active === 'appointments' ? 'active' : '' %>"><i class="bi bi-calendar-check"></i><span><%= t('sidebar.appointments') %></span></a>
        <a href="/hms/doctor/triage.php" class="<%= active === 'triage' ? 'active' : '' %>"><i class="bi bi-heart-pulse"></i><span><%= t('sidebar.triage') %></span></a>
        <a href="/hms/doctor/beds.php" class="<%= active === 'beds' ? 'active' : '' %>"><i class="bi bi-hospital"></i><span><%= t('sidebar.beds') %></span></a>
        <a href="/hms/doctor/prescriptions.php" class="<%= active === 'prescriptions' ? 'active' : '' %>"><i class="bi bi-file-medical"></i><span><%= t('sidebar.prescriptions') %></span></a>
        <a href="/hms/doctor/lab-orders.php" class="<%= active === 'labs' ? 'active' : '' %>"><i class="bi bi-clipboard2-pulse"></i><span><%= t('sidebar.labExams') %></span></a>
        <a href="/hms/doctor/manage-patient.php" class="<%= active === 'patients' ? 'active' : '' %>"><i class="bi bi-people"></i><span><%= t('sidebar.patients') %></span></a>
        <a href="/hms/doctor/availability.php" class="<%= active === 'availability' ? 'active' : '' %>"><i class="bi bi-clock"></i><span><%= t('sidebar.availability') %></span></a>
        <div class="hms-nav-section"><%= t('sidebar.account') %></div>
        <a href="/hms/doctor/edit-profile.php" class="<%= active === 'profile' ? 'active' : '' %>"><i class="bi bi-person"></i><span><%= t('sidebar.profile') %></span></a>
        <a href="/hms/doctor/change-password.php" class="<%= active === 'password' ? 'active' : '' %>"><i class="bi bi-key"></i><span><%= t('sidebar.password') %></span></a>
        <a href="/hms/doctor/logout.php"><i class="bi bi-box-arrow-right"></i><span><%= t('sidebar.logout') %></span></a>
      <% } else if (role === 'admin') { %>
        <div class="hms-nav-section"><%= t('sidebar.operations') %></div>
        <a href="/hms/admin/dashboard.php" class="<%= active === 'dashboard' ? 'active' : '' %>"><i class="bi bi-grid"></i><span><%= t('sidebar.dashboard') %></span></a>
        <a href="/hms/admin/appointment-history.php" class="<%= active === 'appointments' ? 'active' : '' %>"><i class="bi bi-calendar-check"></i><span><%= t('sidebar.appointments') %></span></a>
        <a href="/hms/admin/triage.php" class="<%= active === 'triage' ? 'active' : '' %>"><i class="bi bi-heart-pulse"></i><span><%= t('sidebar.triage') %></span></a>
        <a href="/hms/admin/beds.php" class="<%= active === 'beds' ? 'active' : '' %>"><i class="bi bi-hospital"></i><span><%= t('sidebar.beds') %></span></a>
        <a href="/hms/admin/lab-orders.php" class="<%= active === 'labs' ? 'active' : '' %>"><i class="bi bi-clipboard2-pulse"></i><span><%= t('sidebar.labExams') %></span></a>
        <a href="/hms/admin/pharmacy.php" class="<%= active === 'pharmacy' ? 'active' : '' %>"><i class="bi bi-capsule"></i><span><%= t('sidebar.pharmacy') %></span></a>
        <a href="/hms/admin/billing.php" class="<%= active === 'billing' ? 'active' : '' %>"><i class="bi bi-receipt"></i><span><%= t('sidebar.billing') %></span></a>
        <div class="hms-nav-section"><%= t('sidebar.clinicalOps') %></div>
        <a href="/hms/admin/manage-doctors.php" class="<%= active === 'doctors' ? 'active' : '' %>"><i class="bi bi-person-badge"></i><span><%= t('sidebar.doctors') %></span></a>
        <a href="/hms/admin/doctor-availability.php" class="<%= active === 'availability' ? 'active' : '' %>"><i class="bi bi-clock"></i><span><%= t('sidebar.availability') %></span></a>
        <a href="/hms/admin/doctor-specilization.php" class="<%= active === 'specializations' ? 'active' : '' %>"><i class="bi bi-diagram-3"></i><span><%= t('sidebar.specializations') %></span></a>
        <a href="/hms/admin/manage-users.php" class="<%= active === 'users' ? 'active' : '' %>"><i class="bi bi-people"></i><span><%= t('sidebar.users') %></span></a>
        <a href="/hms/admin/manage-patient.php" class="<%= active === 'patients' ? 'active' : '' %>"><i class="bi bi-person-vcard"></i><span><%= t('sidebar.patients') %></span></a>
        <div class="hms-nav-section"><%= t('sidebar.monitoring') %></div>
        <a href="/hms/admin/notifications.php" class="<%= active === 'notifications' ? 'active' : '' %>"><i class="bi bi-bell"></i><span><%= t('sidebar.notifications') %></span></a>
        <a href="/hms/admin/unread-queries.php" class="<%= active === 'queries' ? 'active' : '' %>"><i class="bi bi-chat-left-text"></i><span><%= t('sidebar.queries') %></span></a>
        <a href="/hms/admin/between-dates-reports.php" class="<%= active === 'reports' ? 'active' : '' %>"><i class="bi bi-file-earmark-bar-graph"></i><span><%= t('sidebar.reports') %></span></a>
        <a href="/hms/admin/audit-logs.php" class="<%= active === 'audit' ? 'active' : '' %>"><i class="bi bi-shield-check"></i><span><%= t('sidebar.audit') %></span></a>
        <a href="/hms/admin/about-us.php" class="<%= active === 'aboutus' ? 'active' : '' %>"><i class="bi bi-info-circle"></i><span><%= t('sidebar.aboutCms') %></span></a>
        <a href="/hms/admin/contact.php" class="<%= active === 'contactus' ? 'active' : '' %>"><i class="bi bi-telephone"></i><span><%= t('sidebar.contactCms') %></span></a>
        <a href="/hms/admin/change-password.php" class="<%= active === 'password' ? 'active' : '' %>"><i class="bi bi-key"></i><span><%= t('sidebar.password') %></span></a>
        <a href="/hms/admin/logout.php"><i class="bi bi-box-arrow-right"></i><span><%= t('sidebar.logout') %></span></a>
      <% } %>
    </nav>
  </aside>
  <div class="hms-main">
    <header class="hms-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('hmsSidebar').classList.toggle('open')">
          <i class="bi bi-list"></i>
        </button>
        <div class="hms-meta-line">
          <span><%= t('roles.' + role) %></span>
          <span aria-hidden="true">/</span>
          <span class="text-dark fw-semibold"><%= title %></span>
        </div>
      </div>
      <div class="d-flex align-items-center gap-3">
        <div class="hms-lang-switch" role="group" aria-label="Language">
          <a href="/lang/pt?next=<%= encodeURIComponent(currentUrl) %>" class="<%= lang === 'pt' ? 'active' : '' %>">PT</a>
          <a href="/lang/en?next=<%= encodeURIComponent(currentUrl) %>" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
        </div>
        <span class="small text-muted d-none d-sm-inline"><%= currentUserName || t('roles.' + role) %></span>
        <a class="hms-btn-secondary py-1 px-2 small" href="/"><%= t('publicSite') %></a>
      </div>
    </header>
    <main class="hms-content">
      <% if (flashes && flashes.length) { %>
        <% flashes.forEach(function(f) { %>
          <div class="alert alert-<%= f.type %> alert-dismissible fade show border" role="alert">
            <%= f.message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% }); %>
      <% } %>
