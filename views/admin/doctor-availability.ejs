<%- include('../partials/layout-header', { title: t('sidebar.availability'), role: 'admin', active: 'availability' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.availability') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Gerenciamento centralizado de escalas e horários médicos.' : 'Admin schedule control for all physicians.' %></div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="hms-surface-card p-3">
      <h2 class="h5 mb-3"><%= lang === 'pt' ? 'Adicionar Escala' : 'Add Slot' %></h2>
      <form method="post" action="/hms/admin/doctor-availability.php">
        <input type="hidden" name="action" value="create">
        <div class="mb-3">
          <label class="form-label"><%= t('common.doctor') %></label>
          <select class="form-select" name="doctor_id" required>
            <option value=""><%= lang === 'pt' ? 'Selecione o médico' : 'Select doctor' %></option>
            <% doctors.forEach(function(doctor) { %>
              <option value="<%= doctor.id %>"><%= doctor.doctorName %> - <%= doctor.specilization %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= lang === 'pt' ? 'Dia da Semana' : 'Weekly Day' %></label>
          <select class="form-select" name="day_of_week" required>
            <% days.forEach(function(dayName, index) { %>
              <option value="<%= index %>"><%= dayName %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= lang === 'pt' ? 'Data Específica' : 'Specific Date' %></label>
          <input class="form-control" type="date" name="available_date">
        </div>
        <div class="row g-3">
          <div class="col-6"><label class="form-label"><%= lang === 'pt' ? 'Início' : 'Start' %></label><input class="form-control" type="time" name="start_time" required></div>
          <div class="col-6"><label class="form-label"><%= lang === 'pt' ? 'Término' : 'End' %></label><input class="form-control" type="time" name="end_time" required></div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-6"><label class="form-label"><%= lang === 'pt' ? 'Minutos' : 'Slot Minutes' %></label><input class="form-control" type="number" name="slot_duration_minutes" min="5" value="30" required></div>
          <div class="col-6"><label class="form-label"><%= lang === 'pt' ? 'Vagas' : 'Max Bookings' %></label><input class="form-control" type="number" name="max_appointments" min="1" value="1" required></div>
        </div>
        <button class="hms-btn-primary w-100 mt-4" type="submit"><%= t('common.save') %></button>
      </form>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="hms-surface-card p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0"><%= lang === 'pt' ? 'Escalas Ativas' : 'Schedules' %></h2>
        <input class="form-control form-control-sm" style="max-width:260px" placeholder="<%= t('common.search') %>" data-table-search="#availabilityTable">
      </div>
      <div class="table-responsive">
        <table class="hms-table" id="availabilityTable" data-sortable>
          <thead>
          <tr>
            <th data-sort><%= t('common.doctor') %></th>
            <th data-sort><%= lang === 'pt' ? 'Dia / Data' : 'Day / Date' %></th>
            <th data-sort><%= t('common.time') %></th>
            <th data-sort><%= lang === 'pt' ? 'Capacidade' : 'Capacity' %></th>
            <th class="text-end"><%= t('common.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% slots.forEach(function(slot) { %>
            <tr>
              <td class="fw-semibold"><%= slot.doctorName %></td>
              <td class="tabular"><%= slot.available_date || days[slot.day_of_week] %></td>
              <td class="tabular"><%= String(slot.start_time).slice(0, 5) %> - <%= String(slot.end_time).slice(0, 5) %></td>
              <td class="tabular"><%= slot.slot_duration_minutes %> min · <%= slot.max_appointments %> <%= lang === 'pt' ? 'vagas' : 'slots' %></td>
              <td class="text-end">
                <form method="post" action="/hms/admin/doctor-availability.php" onsubmit="return confirm('<%= lang === 'pt' ? 'Remover esta escala?' : 'Remove this slot?' %>');">
                  <input type="hidden" name="action" value="delete">
                  <input type="hidden" name="id" value="<%= slot.id %>">
                  <button class="btn btn-sm btn-outline-secondary" type="submit"><%= t('common.remove') %></button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (!slots.length) { %>
            <tr><td colspan="5" class="text-center text-muted py-4"><%= t('common.noRecords') %></td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/layout-footer') %>
