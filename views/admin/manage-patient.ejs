<%- include('../partials/layout-header', { title: t('sidebar.patients'), role: 'admin', active: 'patients' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.patients') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Consulte prontuários clínicos e evoluções registradas pelos médicos.' : 'Inspect clinical patient records and medical histories.' %></div>
  </div>
</div>

<div class="hms-surface-card p-3">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
    <h2 class="h5 mb-0"><%= t('sidebar.patients') %></h2>
    <input type="search" class="form-control form-control-sm" style="max-width: 320px;" placeholder="<%= t('common.search') %>" data-table-search="#adminPatientsTable">
  </div>
  <div class="table-responsive">
    <table class="hms-table" id="adminPatientsTable" data-sortable>
      <thead>
      <tr>
        <th data-sort>#</th>
        <th data-sort><%= t('common.patient') %></th>
        <th data-sort><%= t('home.phone') %></th>
        <th data-sort><%= t('auth.gender') %></th>
        <th data-sort><%= t('common.doctor') %></th>
        <th data-sort><%= lang === 'pt' ? 'Cadastro' : 'Created' %></th>
        <th class="text-end"><%= t('common.actions') %></th>
      </tr>
      </thead>
      <tbody>
      <% patients.forEach(function(p, index) { %>
        <tr>
          <td class="tabular text-muted"><%= index + 1 %></td>
          <td class="fw-semibold"><%= p.PatientName %></td>
          <td class="tabular"><%= p.PatientContno %></td>
          <td><%= p.PatientGender %></td>
          <td><%= p.doctorName || '-' %></td>
          <td class="tabular"><%= p.CreationDate %></td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="/hms/admin/view-patient.php?viewid=<%= p.ID %>"><i class="bi bi-eye me-1"></i><%= t('common.view') %></a>
          </td>
        </tr>
      <% }); %>
      <% if (!patients.length) { %>
        <tr><td colspan="7" class="text-center text-muted py-4"><%= t('common.noRecords') %></td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/layout-footer') %>
