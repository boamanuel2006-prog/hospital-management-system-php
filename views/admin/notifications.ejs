<%- include('../partials/layout-header', { title: t('sidebar.notifications'), role: 'admin', active: 'notifications' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.notifications') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Alertas de novas consultas, solicitações de contato e fluxos clínicos.' : 'New appointment requests, contact queries, and workflow alerts.' %></div>
  </div>
  <% if (notifications.length) { %>
    <form method="post" action="/hms/admin/notifications.php">
      <button class="hms-btn-secondary" type="submit"><%= lang === 'pt' ? 'Marcar Todas como Lidas' : 'Mark All Read' %></button>
    </form>
  <% } %>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="hms-surface-card p-3">
      <h2 class="h5 mb-3"><%= t('sidebar.notifications') %></h2>
      <% if (notifications.length) { %>
        <div class="list-group list-group-flush">
          <% notifications.forEach(function(notification) { %>
            <div class="list-group-item px-0 d-flex gap-3 justify-content-between align-items-start">
              <div>
                <div class="fw-semibold">
                  <%= notification.title %>
                  <% if (Number(notification.is_read) === 0) { %>
                    <span class="ms-2 small fw-semibold" style="color: var(--hms-accent);">· <%= lang === 'pt' ? 'Nova' : 'New' %></span>
                  <% } %>
                </div>
                <div class="text-muted small tabular"><%= notification.created_at %></div>
                <div class="small mt-1"><%= notification.message %></div>
              </div>
              <% if (Number(notification.is_read) === 0) { %>
                <form method="post" action="/hms/admin/notifications.php">
                  <input type="hidden" name="id" value="<%= notification.id %>">
                  <button class="btn btn-sm btn-outline-secondary" type="submit"><%= lang === 'pt' ? 'Lida' : 'Read' %></button>
                </form>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-muted small"><%= t('common.noRecords') %></div>
      <% } %>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="hms-surface-card p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0"><%= lang === 'pt' ? 'Mensagens Pendentes' : 'Unread Queries' %></h2>
        <a class="btn btn-sm btn-outline-primary" href="/hms/admin/unread-queries.php"><%= t('sidebar.queries') %></a>
      </div>
      <% if (queries.length) { %>
        <div class="hms-timeline">
          <% queries.forEach(function(query) { %>
            <div class="hms-timeline-item">
              <div class="fw-semibold"><%= query.fullname %></div>
              <div class="small text-muted"><%= query.email %> · <span class="tabular"><%= query.contactno %></span></div>
              <div class="small mt-1"><%= query.message %></div>
              <a class="small" href="/hms/admin/query-details.php?id=<%= query.id %>"><%= t('common.view') %></a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-muted small"><%= t('common.noRecords') %></div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/layout-footer') %>
