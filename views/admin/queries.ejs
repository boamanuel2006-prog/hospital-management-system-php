<%- include('../partials/layout-header', { title: t('sidebar.queries'), role: 'admin', active: 'queries' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= lang === 'pt' ? 'Mensagens de Contato' : heading %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Solicitações enviadas pelo formulário público do hospital.' : 'Public contact inquiries submitted from the website.' %></div>
  </div>
  <div class="d-flex gap-2">
    <a class="hms-btn-secondary btn-sm" href="/hms/admin/unread-queries.php"><%= lang === 'pt' ? 'Não Lidas' : 'Unread' %></a>
    <a class="hms-btn-secondary btn-sm" href="/hms/admin/read-query.php"><%= lang === 'pt' ? 'Respondidas' : 'Read' %></a>
  </div>
</div>

<div class="hms-surface-card p-3">
  <div class="table-responsive">
    <table class="hms-table" data-sortable>
      <thead>
      <tr>
        <th data-sort>#</th>
        <th data-sort><%= t('home.fullName') %></th>
        <th data-sort><%= t('home.email') %></th>
        <th data-sort><%= t('home.phone') %></th>
        <th data-sort><%= t('common.date') %></th>
        <th class="text-end"><%= t('common.actions') %></th>
      </tr>
      </thead>
      <tbody>
      <% queries.forEach(function(q, idx) { %>
        <tr>
          <td class="tabular text-muted"><%= idx + 1 %></td>
          <td class="fw-semibold"><%= q.fullname %></td>
          <td><%= q.email %></td>
          <td class="tabular"><%= q.contactno %></td>
          <td class="tabular"><%= q.PostingDate %></td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="/hms/admin/query-details.php?id=<%= q.id %>"><%= t('common.view') %></a>
          </td>
        </tr>
      <% }); %>
      <% if (!queries.length) { %>
        <tr><td colspan="6" class="text-center text-muted py-4"><%= t('common.noRecords') %></td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/layout-footer') %>
