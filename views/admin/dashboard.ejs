<%- include('../partials/layout-header', { title: t('sidebar.dashboard'), role: 'admin', active: 'dashboard' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= lang === 'pt' ? 'Painel de Administração Hospitalar' : 'Hospital Administration Dashboard' %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Visão operacional de leitos, triagem, farmácia, faturamento, consultas e auditoria.' : 'Operational overview of inpatient beds, triage, pharmacy, billing, visits, and audit logs.' %></div>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="hms-btn-secondary" href="/hms/admin/beds.php"><i class="bi bi-hospital"></i><%= t('sidebar.beds') %></a>
    <a class="hms-btn-primary" href="/hms/admin/appointment-history.php"><i class="bi bi-calendar-check"></i><%= t('sidebar.appointments') %></a>
  </div>
</div>

<div class="hms-kpi-grid">
  <a class="hms-kpi-card" href="/hms/admin/beds.php">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Leitos Disponíveis' : 'Available Beds' %></div>
    <div class="hms-kpi-value"><%= stats.availableBeds %> / <%= stats.totalBeds %></div>
    <div class="hms-kpi-foot"><%= t('sidebar.beds') %></div>
  </a>
  <a class="hms-kpi-card" href="/hms/admin/triage.php">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Aguardando Triagem' : 'Triage Waiting' %></div>
    <div class="hms-kpi-value"><%= stats.triageWaiting %></div>
    <div class="hms-kpi-foot"><%= t('sidebar.triage') %></div>
  </a>
  <a class="hms-kpi-card" href="/hms/admin/pharmacy.php">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Alertas de Farmácia' : 'Low Stock Alerts' %></div>
    <div class="hms-kpi-value"><%= stats.lowStockMeds %></div>
    <div class="hms-kpi-foot"><%= t('sidebar.pharmacy') %></div>
  </a>
  <a class="hms-kpi-card" href="/hms/admin/billing.php">
    <div class="hms-kpi-label"><%= lang === 'pt' ? 'Guias em Aberto' : 'Unpaid Invoices' %></div>
    <div class="hms-kpi-value"><%= stats.unpaidInvoices %></div>
    <div class="hms-kpi-foot"><%= t('sidebar.billing') %></div>
  </a>
  <a class="hms-kpi-card" href="/hms/admin/manage-doctors.php">
    <div class="hms-kpi-label"><%= t('sidebar.doctors') %></div>
    <div class="hms-kpi-value"><%= stats.doctors %></div>
    <div class="hms-kpi-foot tabular"><%= stats.users %> <%= t('sidebar.users') %></div>
  </a>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="hms-surface-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2 class="h5 mb-1"><%= lang === 'pt' ? 'Fluxo de Consultas por Status' : 'Appointment Status Breakdown' %></h2>
          <div class="text-muted small"><%= lang === 'pt' ? 'Distribuição entre pendentes, aprovadas, concluídas e canceladas.' : 'Pending, approved, completed, and cancelled appointments.' %></div>
        </div>
        <span class="hms-meta-line"><strong class="tabular text-dark"><%= stats.appointments %></strong><span><%= t('common.total') %></span></span>
      </div>
      <canvas id="appointmentStatusChart" height="120"></canvas>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="hms-surface-card p-3 h-100 d-flex flex-column justify-content-between">
      <div>
        <h2 class="h5 mb-3"><%= lang === 'pt' ? 'Indicadores Operacionais' : 'Operational Signals' %></h2>
        <div class="d-flex justify-content-between py-2 border-bottom">
          <span class="text-muted"><%= t('sidebar.notifications') %></span>
          <strong class="tabular"><%= unreadNotifications %></strong>
        </div>
        <div class="d-flex justify-content-between py-2 border-bottom">
          <span class="text-muted"><%= t('sidebar.queries') %></span>
          <strong class="tabular"><%= stats.newQueries %></strong>
        </div>
        <div class="d-flex justify-content-between py-2">
          <span class="text-muted"><%= t('sidebar.patients') %></span>
          <strong class="tabular"><%= stats.patients %></strong>
        </div>
      </div>
      <div class="mt-3 d-grid gap-2">
        <a class="hms-btn-secondary" href="/hms/admin/notifications.php"><i class="bi bi-bell"></i><%= t('sidebar.notifications') %></a>
        <a class="hms-btn-secondary" href="/hms/admin/audit-logs.php"><i class="bi bi-shield-check"></i><%= t('sidebar.audit') %></a>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-xl-8">
    <div class="hms-surface-card p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0"><%= lang === 'pt' ? 'Consultas Recentes' : 'Recent Appointments' %></h2>
        <a class="btn btn-sm btn-outline-primary" href="/hms/admin/appointment-history.php"><%= lang === 'pt' ? 'Ver Todas' : 'View All' %></a>
      </div>
      <div class="table-responsive">
        <table class="hms-table" data-sortable>
          <thead>
          <tr>
            <th data-sort><%= t('common.patient') %></th>
            <th data-sort><%= t('common.doctor') %></th>
            <th data-sort><%= t('common.date') %></th>
            <th data-sort><%= t('common.status') %></th>
            <th class="text-end"><%= t('common.fee') %></th>
          </tr>
          </thead>
          <tbody>
          <% recentAppointments.forEach(function(appointment) { %>
            <tr>
              <td><%= appointment.fullName %></td>
              <td>
                <div class="fw-semibold"><%= appointment.doctorName %></div>
                <div class="small text-muted"><%= appointment.doctorSpecialization %></div>
              </td>
              <td class="tabular"><%= appointment.appointmentDate %> <%= appointment.appointmentTime %></td>
              <td><%- statusBadge(appointment.status) %></td>
              <td class="text-end tabular">R$ <%= appointment.consultancyFees %></td>
            </tr>
          <% }); %>
          <% if (!recentAppointments.length) { %>
            <tr><td colspan="5" class="text-center text-muted py-4"><%= t('common.noRecords') %></td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-xl-4">
    <div class="hms-surface-card p-3">
      <h2 class="h5 mb-3"><%= lang === 'pt' ? 'Atividade Recente' : 'Recent Activity' %></h2>
      <% if (recentActivities.length) { %>
        <div class="hms-timeline">
          <% recentActivities.forEach(function(activity) { %>
            <div class="hms-timeline-item">
              <div class="fw-semibold"><%= activity.action.replace(/_/g, ' ') %></div>
              <div class="small text-muted"><%= activity.actor_type %> · <%= activity.entity_type %> #<%= activity.entity_id %></div>
              <div class="small"><%= activity.details %></div>
              <div class="small text-muted tabular"><%= activity.created_at %></div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-muted small"><%= t('common.noRecords') %></div>
      <% } %>
    </div>
  </div>
</div>
<% const localizedStatusLabels = statusLabels.map((s) => t('status.' + s)); %>
<% const extraScript = `<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
new Chart(document.getElementById("appointmentStatusChart"), {
  type: "bar",
  data: {
    labels: ${JSON.stringify(localizedStatusLabels)},
    datasets: [{
      label: ${JSON.stringify(t('sidebar.appointments'))},
      data: ${JSON.stringify(statusTotals)},
      backgroundColor: ["#b45309", "#1d4ed8", "#15803d", "#64748b"],
      borderRadius: 6
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
  }
});
</script>`; %>
<%- include('../partials/layout-footer', { extraScript }) %>
