<%- include('../partials/layout-header', { title: 'Admin Dashboard', role: 'admin', active: 'dashboard' }) %>
<div class="hms-page-title">
  <div>
    <h1>Admin Dashboard</h1>
    <div class="text-muted">Operational overview, appointment flow, and recent activity.</div>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-primary" href="/hms/admin/appointment-history.php"><i class="bi bi-calendar-check me-1"></i>Manage Appointments</a>
    <a class="btn btn-primary" href="/hms/admin/doctor-availability.php"><i class="bi bi-clock-history me-1"></i>Doctor Availability</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <a class="hms-card hms-stat d-block text-reset" href="/hms/admin/manage-users.php">
      <span class="icon"><i class="bi bi-people"></i></span>
      <div class="value"><%= stats.users %></div>
      <div class="label">Registered Users</div>
    </a>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <a class="hms-card hms-stat d-block text-reset" href="/hms/admin/manage-doctors.php">
      <span class="icon"><i class="bi bi-person-badge"></i></span>
      <div class="value"><%= stats.doctors %></div>
      <div class="label">Doctors</div>
    </a>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <a class="hms-card hms-stat d-block text-reset" href="/hms/admin/manage-patient.php">
      <span class="icon"><i class="bi bi-person-vcard"></i></span>
      <div class="value"><%= stats.patients %></div>
      <div class="label">Patient Records</div>
    </a>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <a class="hms-card hms-stat d-block text-reset" href="/hms/admin/unread-queries.php">
      <span class="icon"><i class="bi bi-chat-left-text"></i></span>
      <div class="value"><%= stats.newQueries %></div>
      <div class="label">New Queries</div>
    </a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="hms-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2 class="h5 mb-1">Appointment Status</h2>
          <div class="text-muted small">Pending, approved, completed, and cancelled appointments.</div>
        </div>
        <span class="badge text-bg-light"><%= stats.appointments %> total</span>
      </div>
      <canvas id="appointmentStatusChart" height="120"></canvas>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="hms-card p-3 h-100">
      <h2 class="h5 mb-3">Signals</h2>
      <div class="d-flex justify-content-between py-2 border-bottom">
        <span class="text-muted">Unread notifications</span>
        <strong><%= unreadNotifications %></strong>
      </div>
      <div class="d-flex justify-content-between py-2 border-bottom">
        <span class="text-muted">New contact queries</span>
        <strong><%= stats.newQueries %></strong>
      </div>
      <div class="d-flex justify-content-between py-2">
        <span class="text-muted">Audit logging</span>
        <strong>Enabled</strong>
      </div>
      <div class="mt-3">
        <a class="btn btn-outline-secondary w-100" href="/hms/admin/notifications.php"><i class="bi bi-bell me-1"></i>View Notifications</a>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-xl-8">
    <div class="hms-card p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Recent Appointments</h2>
        <a class="btn btn-sm btn-outline-primary" href="/hms/admin/appointment-history.php">View All</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-sortable>
          <thead>
          <tr>
            <th data-sort>Patient</th>
            <th data-sort>Doctor</th>
            <th data-sort>Date</th>
            <th data-sort>Status</th>
            <th class="text-end">Fee</th>
          </tr>
          </thead>
          <tbody>
          <% recentAppointments.forEach(function(appointment) { %>
            <tr>
              <td><%= appointment.fullName %></td>
              <td>
                <div class="fw-semibold"><%= appointment.doctorName %></div>
                <div class="small text-muted"><%= appointment.doctorSpecialization %></div>
              </td>
              <td><%= appointment.appointmentDate %> <%= appointment.appointmentTime %></td>
              <td><%- statusBadge(appointment.status) %></td>
              <td class="text-end"><%= appointment.consultancyFees %></td>
            </tr>
          <% }); %>
          <% if (!recentAppointments.length) { %>
            <tr><td colspan="5" class="text-center text-muted py-4">No appointments yet.</td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-xl-4">
    <div class="hms-card p-3">
      <h2 class="h5 mb-3">Recent Activity</h2>
      <% if (recentActivities.length) { %>
        <div class="timeline">
          <% recentActivities.forEach(function(activity) { %>
            <div class="timeline-item">
              <div class="fw-semibold"><%= activity.action.replace(/_/g, ' ') %></div>
              <div class="small text-muted"><%= activity.actor_type %> on <%= activity.entity_type %> #<%= activity.entity_id %></div>
              <div class="small"><%= activity.details %></div>
              <div class="small text-muted"><%= activity.created_at %></div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-muted">No audit activity yet.</div>
      <% } %>
    </div>
  </div>
</div>
<% const extraScript = `<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
new Chart(document.getElementById("appointmentStatusChart"), {
  type: "bar",
  data: {
    labels: ${JSON.stringify(statusLabels)},
    datasets: [{
      label: "Appointments",
      data: ${JSON.stringify(statusTotals)},
      backgroundColor: ["#f59e0b", "#127c8a", "#16a34a", "#64748b"],
      borderRadius: 6
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
  }
});
</script>`; %>
<%- include('../partials/layout-footer', { extraScript }) %>
