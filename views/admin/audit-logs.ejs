<%- include('../partials/layout-header', { title: 'Audit Logs', role: 'admin', active: 'audit' }) %>
<div class="hms-page-title">
  <div>
    <h1>Audit Logs</h1>
    <div class="text-muted">Track sensitive workflow changes and security-relevant actions.</div>
  </div>
</div>

<div class="hms-card p-3 mb-3">
  <form class="row g-3 align-items-end" method="get" action="/hms/admin/audit-logs.php">
    <div class="col-md-4">
      <label class="form-label">Actor</label>
      <select class="form-select" name="actor">
        <option value="">All</option>
        <% ['admin', 'doctor', 'patient'].forEach(function(option) { %>
          <option value="<%= option %>" <%= actor === option ? 'selected' : '' %>><%= option %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Action</label>
      <input class="form-control" name="action" value="<%= action %>" placeholder="appointment, prescription, availability">
    </div>
    <div class="col-md-2 d-grid">
      <button class="btn btn-primary" type="submit">Filter</button>
    </div>
  </form>
</div>

<div class="hms-card p-3">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" data-sortable>
      <thead>
      <tr>
        <th data-sort>Date</th>
        <th data-sort>Actor</th>
        <th data-sort>Action</th>
        <th data-sort>Entity</th>
        <th>Details</th>
        <th data-sort>IP</th>
      </tr>
      </thead>
      <tbody>
      <% logs.forEach(function(log) { %>
        <tr>
          <td><%= log.created_at %></td>
          <td><%= log.actor_type %> #<%= log.actor_id %></td>
          <td><%= log.action %></td>
          <td><%= log.entity_type %> #<%= log.entity_id %></td>
          <td><%= log.details %></td>
          <td><%= log.ip_address %></td>
        </tr>
      <% }); %>
      <% if (!logs.length) { %>
        <tr><td colspan="6" class="text-center text-muted py-4">No audit events found.</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/layout-footer') %>
