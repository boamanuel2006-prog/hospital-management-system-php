<%- include('../partials/layout-header', { title: t('sidebar.reports'), role: 'admin', active: 'reports' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.reports') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Gere relatórios de pacientes cadastrados por intervalo de datas.' : 'Generate a patient registration report for a selected date range.' %></div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="hms-surface-card p-4">
      <form method="post" action="/hms/admin/betweendates-detailsreports.php" class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="fromdate"><%= lang === 'pt' ? 'Data Inicial' : 'From date' %></label>
          <input type="date" class="form-control" id="fromdate" name="fromdate" value="<%= fromdate %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="todate"><%= lang === 'pt' ? 'Data Final' : 'To date' %></label>
          <input type="date" class="form-control" id="todate" name="todate" value="<%= todate %>" required>
        </div>
        <div class="col-12">
          <button type="submit" class="hms-btn-primary">
            <i class="bi bi-file-earmark-text"></i><%= lang === 'pt' ? 'Gerar Relatório' : 'Generate Report' %>
          </button>
        </div>
      </form>
    </div>
  </div>
  <% if (results !== null) { %>
    <div class="col-lg-7">
      <div class="hms-surface-card p-4">
        <h2 class="h5 mb-3"><%= lang === 'pt' ? 'Resultados' : 'Report Results' %> (<span class="tabular"><%= fromdate %></span> - <span class="tabular"><%= todate %></span>)</h2>
        <div class="table-responsive">
          <table class="hms-table mb-0">
            <thead>
              <tr><th>#</th><th><%= t('common.patient') %></th><th><%= t('home.phone') %></th><th><%= t('auth.gender') %></th><th><%= lang === 'pt' ? 'Cadastro' : 'Created' %></th><th><%= t('common.actions') %></th></tr>
            </thead>
            <tbody>
              <% results.forEach(function(p, idx) { %>
                <tr>
                  <td class="tabular text-muted"><%= idx + 1 %></td>
                  <td class="fw-semibold"><%= p.PatientName %></td>
                  <td class="tabular"><%= p.PatientContno %></td>
                  <td><%= p.PatientGender %></td>
                  <td class="tabular"><%= p.CreationDate %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/hms/admin/view-patient.php?viewid=<%= p.ID %>"><%= t('common.view') %></a></td>
                </tr>
              <% }); %>
              <% if (!results.length) { %>
                <tr><td colspan="6" class="text-center text-muted py-3"><%= t('common.noRecords') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>
<%- include('../partials/layout-footer') %>
