<%- include('../partials/layout-header', { title: heading, role: 'admin', active: active }) %>
<div class="hms-page-title">
  <div>
    <h1><%= heading %></h1>
    <p class="text-muted mb-0"><%= subtitle %></p>
  </div>
</div>

<div class="hms-card p-4" style="max-width:760px">
  <form method="post" action="<%= actionUrl %>">
    <div class="mb-3">
      <label class="form-label">Page title</label>
      <input type="text" class="form-control" name="pagetitle" value="<%= page ? page.PageTitle : '' %>" required>
    </div>
    <% if (isContact) { %>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Email address</label>
          <input type="email" class="form-control" name="email" value="<%= page ? page.Email : '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Mobile number</label>
          <input type="text" class="form-control" name="mobnum" value="<%= page ? page.MobileNumber : '' %>" required>
        </div>
      </div>
    <% } %>
    <div class="mb-4">
      <label class="form-label">Page description</label>
      <textarea class="form-control" name="pagedes" rows="8" required><%= page ? page.PageDescription : '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Content</button>
  </form>
</div>
<%- include('../partials/layout-footer') %>
