<%- include('../partials/layout-header', { title: 'Manage Doctors', role: 'admin', active: 'doctors' }) %>
<div class="hms-page-title">
  <div>
    <h1>Manage Doctors</h1>
    <p class="text-muted mb-0">Search, update, and manage registered doctors.</p>
  </div>
  <a class="btn btn-primary" href="/hms/admin/add-doctor.php"><i class="bi bi-person-plus me-1"></i>Add Doctor</a>
</div>

<div class="hms-card p-4">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
    <h2 class="h5 mb-0">Doctors</h2>
    <input type="search" class="form-control" style="max-width: 320px;" placeholder="Search doctors..." data-table-search="#doctorsTable">
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle" id="doctorsTable" data-sortable>
      <thead>
      <tr>
        <th data-sort>#</th>
        <th data-sort>Specialization</th>
        <th data-sort>Doctor</th>
        <th data-sort>Email</th>
        <th data-sort>Fees</th>
        <th class="text-end">Action</th>
      </tr>
      </thead>
      <tbody>
      <% doctors.forEach(function(doctor, index) { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= doctor.specilization %></td>
          <td class="fw-semibold"><%= doctor.doctorName %></td>
          <td><%= doctor.docEmail %></td>
          <td><%= doctor.docFees %></td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="/hms/admin/edit-doctor.php?id=<%= doctor.id %>"><i class="bi bi-pencil-square"></i></a>
            <form method="post" action="/hms/admin/manage-doctors.php" class="d-inline" onsubmit="return confirm('Delete this doctor?');">
              <input type="hidden" name="id" value="<%= doctor.id %>">
              <button type="submit" name="delete" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (!doctors.length) { %>
        <tr><td colspan="6" class="text-center text-muted py-4">No doctors found.</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/layout-footer') %>
