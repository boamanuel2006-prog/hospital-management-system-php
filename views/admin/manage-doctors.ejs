<%- include('../partials/layout-header', { title: t('sidebar.doctors'), role: 'admin', active: 'doctors' }) %>
<div class="hms-page-header">
  <div>
    <h1><%= t('sidebar.doctors') %></h1>
    <div class="text-muted"><%= lang === 'pt' ? 'Pesquise, edite e gerencie o corpo clínico cadastrado.' : 'Search, update, and manage registered physicians.' %></div>
  </div>
  <a class="hms-btn-primary" href="/hms/admin/add-doctor.php"><i class="bi bi-person-plus"></i><%= lang === 'pt' ? 'Cadastrar Médico' : 'Add Doctor' %></a>
</div>

<div class="hms-surface-card p-3">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
    <h2 class="h5 mb-0"><%= t('sidebar.doctors') %></h2>
    <input type="search" class="form-control form-control-sm" style="max-width: 320px;" placeholder="<%= t('common.search') %>" data-table-search="#doctorsTable">
  </div>
  <div class="table-responsive">
    <table class="hms-table" id="doctorsTable" data-sortable>
      <thead>
      <tr>
        <th data-sort>#</th>
        <th data-sort><%= t('common.specialty') %></th>
        <th data-sort><%= t('common.doctor') %></th>
        <th data-sort><%= t('home.email') %></th>
        <th data-sort class="text-end"><%= t('common.fee') %></th>
        <th class="text-end"><%= t('common.actions') %></th>
      </tr>
      </thead>
      <tbody>
      <% doctors.forEach(function(doctor, index) { %>
        <tr>
          <td class="tabular text-muted"><%= index + 1 %></td>
          <td><%= doctor.specilization %></td>
          <td class="fw-semibold"><%= doctor.doctorName %></td>
          <td><%= doctor.docEmail %></td>
          <td class="text-end tabular">R$ <%= doctor.docFees %></td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="/hms/admin/edit-doctor.php?id=<%= doctor.id %>"><i class="bi bi-pencil-square"></i></a>
            <form method="post" action="/hms/admin/manage-doctors.php" class="d-inline" onsubmit="return confirm('<%= lang === 'pt' ? 'Excluir este médico?' : 'Delete this doctor?' %>');">
              <input type="hidden" name="id" value="<%= doctor.id %>">
              <button type="submit" name="delete" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (!doctors.length) { %>
        <tr><td colspan="6" class="text-center text-muted py-4"><%= t('common.noRecords') %></td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/layout-footer') %>
